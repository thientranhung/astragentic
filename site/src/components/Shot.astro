---
// A photograph of the running system — a SendMessage exchange, a herdr workspace, a
// real board (home order spec §3). The owner has not sent the files yet, so with no
// `src` this renders a dashed 16:9 frame carrying a mono "real screenshot · to come"
// and the caption underneath. Once the file lands under site/public/shots/ the same
// component renders the picture and drops the dashes, so nothing else on the page has
// to change when it does.
//
// The dashes are the one place ink-22 is allowed to draw a border: a solid hairline
// would read as a finished figure, which is exactly what this is not.
import { UI, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  /** What the picture will show. Also the alt text once `src` lands. */
  caption: string;
  /** Path under site/public, e.g. /shots/sendmessage.png. */
  src?: string;
  /** An exchange rendered from HTML (HyperFrames) instead of a photograph: autoplay,
   *  muted, looping, with a poster while it loads. */
  video?: { mp4: string; webm?: string; poster?: string };
  class?: string;
}
const { lang, caption, src, video, class: extra = '' } = Astro.props;
---

<figure class:list={['shot', !src && !video && 'shot--pending', extra]} style={video?.poster ? `--poster:url(${video.poster})` : undefined}>
  {
    video ? (
      <div class="shot-video">
        <video class="shot-img" autoplay muted loop playsinline preload="metadata" poster={video.poster} aria-label={caption}>
          {video.webm && <source src={video.webm} type="video/webm" />}
          <source src={video.mp4} type="video/mp4" />
        </video>
        {/* The recording is a 1920px screen: at phone width its terminal type lands
            under 4px, and no amount of layout fixes that. Fullscreen is the answer, so
            it gets a button of its own rather than living inside the control bar the
            reader has to go looking through. */}
        <button class="shot-full mono" type="button" aria-label={UI.shotZoom[lang]}>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 1.8H1.8V6M10 1.8h4.2V6M6 14.2H1.8V10M10 14.2h4.2V10"
            />
          </svg>
          <span>{UI.shotFullLabel[lang]}</span>
        </button>
      </div>
    ) : src ? (
      <img class="shot-img" src={src} alt={caption} loading="lazy" decoding="async" />
    ) : (
      <div class="shot-frame">
        <p class="shot-mark mono">{UI.shotPending[lang]}</p>
      </div>
    )
  }
  <figcaption class="shot-cap">{caption}</figcaption>
</figure>

<script>
  /* Two things, both only below the breakpoint. Native controls, because they are how a
     reader pauses a loop they are trying to read. And a fullscreen button of our own,
     because fullscreen is the only thing that makes a 1920px capture legible on a phone
     and it should not be buried in the control bar. iOS Safari puts fullscreen on the
     video element under a webkit name rather than the standard one, so both are tried;
     if neither exists the button is not drawn at all. */
  type IosVideo = HTMLVideoElement & { webkitEnterFullscreen?: () => void };

  const narrow = window.matchMedia('(max-width: 780px)');

  const goFull = (wrap: HTMLElement) => {
    const v = wrap.querySelector('video') as IosVideo | null;
    if (!v) return;
    if (wrap.requestFullscreen) void wrap.requestFullscreen().catch(() => v.webkitEnterFullscreen?.());
    else v.webkitEnterFullscreen?.();
  };

  document.querySelectorAll<HTMLElement>('.shot-video').forEach((wrap) => {
    const video = wrap.querySelector('video') as IosVideo | null;
    const button = wrap.querySelector<HTMLButtonElement>('.shot-full');
    if (!video || !button) return;

    const supported = Boolean(wrap.requestFullscreen || video.webkitEnterFullscreen);
    if (!supported) button.remove();
    else button.addEventListener('click', () => goFull(wrap));

    const apply = () => {
      video.controls = narrow.matches;
      /* Controls own the tap once they are drawn, so the button hands the gesture back:
         it is the one place on the picture that means "make this bigger". */
      wrap.dataset.narrow = narrow.matches ? '' : 'no';
    };
    apply();
    narrow.addEventListener('change', apply);
  });
</script>

<style>
  .shot {
    /* shorthand would reset margin-left and undo the .breakout offset */
    margin-block: 1.75rem 0;
  }
  /* 16:9 whether the picture has landed or not, so the page does not reflow the day it
     does. */
  .shot-frame,
  .shot-img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
  }
  .shot-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2);
    border: 1px dashed var(--ink-22);
  }
  .shot-img {
    object-fit: cover;
    border: 1px solid var(--ink-10);
  }
  .shot-video {
    position: relative;
  }
  /* Wide screens read the capture as drawn; the button would be furniture. */
  .shot-full {
    display: none;
  }
  @media (max-width: 780px) {
    .shot-full {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      min-height: 36px;
      padding-inline: 0.65rem;
      border: 0;
      border-radius: var(--radius-control);
      font-family: var(--font-mono);
      font-size: var(--text-label-sm);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      /* The capture underneath is a dark terminal and its brightness moves, so the
         button carries its own ground rather than trusting the frame. */
      color: var(--surface);
      background: rgb(14 15 20 / 72%);
      backdrop-filter: blur(6px);
      cursor: pointer;
    }
    .shot-full:active {
      background: rgb(14 15 20 / 88%);
    }
    .shot-full svg {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* the poster stands in; the reader can still play it with the native controls */
    .shot-video video {
      display: none;
    }
    .shot-video::before {
      content: '';
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-card);
      background: var(--surface-2) center / cover no-repeat;
      background-image: var(--poster);
    }
  }
  .shot-mark {
    margin: 0;
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-62);
    text-align: center;
    padding-inline: 1.5rem;
  }
  .shot-cap {
    margin: 0.7rem 0 0;
    font-size: var(--text-body-sm);
    line-height: 1.45;
    color: var(--ink-muted);
    max-width: 62ch;
  }
</style>
