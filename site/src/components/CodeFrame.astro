---
// A pane of literal commands: the aihero window bar (three dots on a strip, from the
// global `.codeframe` rule), a line number down the left, and one copy button that
// hands the reader the whole block. Every command on the site goes through here, so
// the quickstart on /cai and the two blocks on the landing cannot drift apart.
//
// The copy script lives here and nowhere else. It binds every `[data-copy]` button on
// the page, so a second component must never ship its own copy of it.
import { UI, type Lang } from '../lib/site';

interface Props {
  /** One command per line. Kept English in both locales (PRD §4). */
  lines: string[];
  lang: Lang;
  /** Mono caption above the pane. Omitted when the section heading already says it. */
  label?: string;
  class?: string;
}
const { lines, lang, label, class: extra = '' } = Astro.props;
const payload = lines.join('\n');
---

<div class:list={['frame', extra]}>
  <div class="cmd-head">
    {label && <p class="label mono">{label}</p>}
    <button
      class="copy mono"
      type="button"
      data-copy
      data-label={UI.copy[lang]}
      data-done={UI.copied[lang]}
      data-payload={payload}
    >{UI.copy[lang]}</button>
  </div>
  <ol class="cmds codeframe">
    {
      lines.map((line) => {
        // The runner is the word the reader types; what follows is the thing being
        // run. Colouring the second half is the only syntax this site has.
        const cut = line.indexOf(' ');
        const head = cut === -1 ? line : line.slice(0, cut);
        const rest = cut === -1 ? '' : line.slice(cut);
        return (
          <li>
            <pre class="mono" lang="en">{head}<span class="cmd-key">{rest}</span></pre>
          </li>
        );
      })
    }
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const payload = button.dataset.payload ?? '';
      try {
        await navigator.clipboard.writeText(payload);
      } catch {
        const box = document.createElement('textarea');
        box.value = payload;
        document.body.append(box);
        box.select();
        document.execCommand('copy');
        box.remove();
      }
      button.textContent = button.dataset.done ?? 'Copied';
      window.setTimeout(() => {
        button.textContent = button.dataset.label ?? 'Copy';
      }, 1600);
    });
  });
</script>

<style>
  .cmd-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .label {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin: 0 0 0.85rem;
  }
  /* With no caption the button is the whole row, and it belongs at the pane's right
     edge rather than its left. */
  .copy {
    margin-left: auto;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    background: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius-badge);
    padding: 0.55rem 0.9rem;
    min-height: 36px;
    cursor: pointer;
  }
  @media (pointer: coarse) {
    .copy {
      min-height: var(--row-h);
      padding-inline: 1rem;
    }
  }
  .copy:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  /* No padding here: the global `.codeframe` rule owns it, and it is what clears the
     30px window bar above the first line. */
  .cmds {
    list-style: none;
    counter-reset: step;
    margin: 0.85rem 0 0;
  }
  .cmds li {
    counter-increment: step;
    position: relative;
    padding-left: 3.1rem;
    margin: 0;
  }
  .cmds li + li {
    border-top: 1px solid var(--ink-05);
  }
  .cmds li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 1.1rem;
    top: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--ink-62);
  }
  .cmds pre {
    font-size: var(--text-mono);
    padding: 0.45rem 1.1rem 0.45rem 0;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: visible;
  }
</style>
