---
// An archify SVG made touchable (landing spec §5). The SVG already ships
// `id="node-<id>"`, `data-node-id`, `tabindex="0"` and `role="button"` on every node,
// so this component only has to decide which of them lead somewhere.
//
// A node named in `hrefMap` gets `class="is-link"` at build time — hover and focus
// highlighting are pure CSS and work with JavaScript off. The script adds the two
// things CSS cannot do: navigation on click/Enter, and the mono tooltip built from
// `data-node-sublabel` and `data-node-tag`. A node absent from the map is left exactly
// as the diagrammer drew it.
//
// LANGUAGE (PRD §4). A Vietnamese page renders src/assets/diagrams/vi/<slug>.svg. If the
// diagrammer has not delivered that file yet, the English one renders and the build
// prints a warning naming the missing file — a visible gap, never a silent mix.
import '../styles/diagram.css';
import { UI, type Lang } from '../lib/site';
import { BAND, prepare, stripFocus } from '../lib/diagram';

interface Props {
  slug: string;
  lang?: Lang;
  /** node id → href. Nodes not listed stay inert. */
  hrefMap?: Record<string, string>;
  /** Node lit up on arrival, for the role pages. */
  activeId?: string;
  /** Hero art: no pointer, no tooltip, no focus stops. */
  inert?: boolean;
  title?: string;
  /** Caps the rendered width of the whole figure. Unset means the full diagram band. */
  maxWidth?: number;
  /** Caps the SVG inside a full-width figure and centres it — for a tall diagram that
   *  would otherwise leave a third of the band empty. */
  svgMaxWidth?: number;
  /** Show the "open the interactive version" caption under the figure. */
  explore?: boolean;
  /** Animate the flows: a pulse in the receiving role's colour travels each edge,
   *  one edge after another, in document order, and a pulse in the sender's colour
   *  comes back. `'sequence'` is for a picture whose arrows already run both ways:
   *  one pulse per edge in the sender's colour, in edge order, no return leg.
   *  Pure CSS; paused off-screen; off under reduced motion. */
  flow?: boolean | 'sequence';
  /** Sequence mode only: which edge keys share a slot, in play order. Edges not listed
   *  play after the listed slots, one per slot. `[[0,1,2],[3]]` fires three inputs
   *  together, then the result. */
  flowSlots?: number[][];
  /** What comes back on each edge, keyed by the receiving node id: shown in place of
   *  the edge label while the return pulse runs. An edge with no entry keeps its label. */
  flowBack?: Record<string, string>;
  class?: string;
}
const {
  slug,
  lang = 'vi',
  hrefMap = {},
  activeId,
  inert = false,
  title,
  maxWidth,
  svgMaxWidth,
  explore = false,
  flow = false,
  flowBack = {},
  flowSlots,
  class: extra = '',
} = Astro.props;

const mod = import.meta.glob('/src/assets/diagrams/**/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const localised = lang === 'vi' ? mod[`/src/assets/diagrams/vi/${slug}.svg`] : undefined;
const english = mod[`/src/assets/diagrams/${slug}.svg`];
if (lang === 'vi' && !localised && english) {
  console.warn(
    `[diagram] no Vietnamese diagram for "${slug}" — rendering the English one. ` +
      `Expected src/assets/diagrams/vi/${slug}.svg`,
  );
}
const raw = localised ?? english ?? null;
const localisedOk = Boolean(localised) || lang === 'en';
const exploreHref = localisedOk && lang === 'vi' ? `/explore/vi/${slug}/` : `/explore/${slug}/`;

/** Add `is-link` / `is-active` to the node groups, and — for a node that leads
 *  somewhere — replace the semantics archify drew. Its nodes are `role="button"` with
 *  `aria-label="Focus <name>…"`, which is what they do inside the standalone explore
 *  page. Here a marked node navigates, so it announces itself as a link that opens a
 *  page. A node with no href gives back its tab stop instead: nothing happens when it
 *  is reached, and a keyboard reader should not have to find that out. */
function mark(svg: string): string {
  return svg.replace(/<g id="node-([A-Za-z0-9_-]+)"([^>]*)>/g, (whole, id: string, rest: string) => {
    const links = !inert && Boolean(hrefMap[id]);
    const classes = [links ? 'is-link' : null, id === activeId ? 'is-active' : null].filter(Boolean);

    let attrs = rest;
    if (links) {
      const label = /\sdata-node-label="([^"]*)"/.exec(rest)?.[1] || id;
      attrs = attrs
        .replace(/\srole="button"/, ' role="link"')
        .replace(/\saria-pressed="[^"]*"/, '')
        .replace(/\saria-label="[^"]*"/, ` aria-label="${label} · ${UI.nodeOpens[lang]}"`);
    } else {
      // Not on the map: it goes nowhere, so it does not take a tab stop either.
      attrs = stripFocus(attrs);
    }
    const cls = classes.length ? ` class="${classes.join(' ')}"` : '';
    return `<g${cls} id="node-${id}"${attrs}>`;
  });
}

/** Behind every edge path archify drew, lay two copies that carry the moving pulses:
 *  the request goes down in the receiving role's colour, the answer (a spec, a
 *  handback, a verdict) comes back up in the sender's. `pathLength="1"` normalises the
 *  dash units so one keyframe set fits edges of any length; `data-flow-to` names the
 *  role whose colour the pulse borrows and `data-flow-key` its place in the queue. No
 *  marker, so the pulse ends at the arrowhead the original already draws.
 *
 *  The words are the diagrammer's own edge labels: each lights up in the role's
 *  colour while its request runs, and — when the page said what comes back — swaps
 *  to that text while the answer runs. No extra vocabulary, so no edge is described
 *  by a word that is true of a different edge. */
function flows(svg: string): string {
  const sequence = flow === 'sequence';
  const withPulses = svg.replace(
    /<path (data-edge-from="[^"]*" data-edge-to="([^"]*)"[^>]*data-edge-key="(\d+)"[^>]*)\/>/g,
    (whole, attrs: string, to: string, key: string) => {
      const d = /\sd="([^"]*)"/.exec(attrs)?.[1];
      if (!d) return whole;
      const from = /data-edge-from="([^"]*)"/.exec(attrs)?.[1] ?? '';
      const out = `${whole}<path class="a-flow a-flow--out" data-flow-from="${from}" data-flow-to="${to}" data-flow-key="${key}" d="${d}" pathLength="1"/>`;
      if (sequence) return out;
      return `${out}<path class="a-flow a-flow--back" data-flow-key="${key}" d="${d}" pathLength="1"/>`;
    },
  );
  return withPulses.replace(
    /<g data-detail="context" (data-edge-from="[^"]*" data-edge-to="([^"]*)"[^>]*data-edge-key="(\d+)"[^>]*)>([\s\S]*?)<\/g>/g,
    (whole, attrs: string, to: string, key: string, inner: string) => {
      const t = /<text x="([\d.]+)" y="([\d.]+)" class="([^"]*)" font-size="([\d.]+)"/.exec(inner);
      const back = flowBack[to];
      let reply = '';
      if (t && back) {
        const [x, y, cls, size] = [Number(t[1]), Number(t[2]), t[3], Number(t[4])];
        // A mask of its own, sized to the word, so the line does not show through.
        const w = back.length * size * 0.62 + 8;
        reply =
          `<g class="a-flow-reply" data-flow-to="${to}" data-flow-key="${key}">` +
          `<rect x="${(x - w / 2).toFixed(1)}" y="${y - size - 2}" width="${w.toFixed(1)}" height="${size + 6}" rx="3" class="c-mask"/>` +
          `<text x="${x}" y="${y}" class="${cls}" font-size="${size}" text-anchor="middle">${back}</text></g>`;
      }
      const from = /data-edge-from="([^"]*)"/.exec(attrs)?.[1] ?? '';
      return `<g class="a-flow-label" data-detail="context" data-flow-from="${from}" data-flow-to="${to}" data-flow-key="${key}" ${attrs}>${inner}</g>${reply}`;
    },
  );
}

const frame = maxWidth ?? svgMaxWidth ?? BAND;
const decorate = (s: string) => {
  const marked = inert ? stripFocus(mark(s)) : mark(s);
  return flow ? flows(marked) : marked;
};
const svg = raw ? prepare(raw, { lang, frame, transform: decorate }).html : null;

/** Sequence mode: N edges take turns in 1.5s slots; the pulse takes 1.1s of its slot
 *  and the label stays lit for the whole slot. The percentages depend on N, so the
 *  keyframes are written here, per figure, rather than in diagram.css. */
const edgeCount = flow === 'sequence' && svg ? (svg.match(/class="a-flow a-flow--out"/g) ?? []).length : 0;
const seqId = `${slug}-${lang}`.replace(/[^a-z0-9-]/gi, '-');
let seqCss = '';
if (edgeCount && svg) {
  const slot = 1.5;
  // slot index per edge key: grouped keys share one, the rest follow one per slot
  const listed = new Set((flowSlots ?? []).flat());
  const slotOf = new Map<number, number>();
  (flowSlots ?? []).forEach((keys, i) => keys.forEach((k) => slotOf.set(k, i)));
  let next = flowSlots?.length ?? 0;
  for (let k = 0; k < edgeCount; k++) if (!listed.has(k)) slotOf.set(k, next++);
  const loop = slot * next;
  const pct = (t: number) => `${((t / loop) * 100).toFixed(3)}%`;
  const sel = (rest: string) => `.idiagram--flow[data-seq="${seqId}"] .diagram-svg ${rest}`;
  // the node each edge lands on, so it can light up as the pulse arrives
  const targets = new Map<string, number>();
  for (const m of svg.matchAll(/class="a-flow a-flow--out" data-flow-from="[^"]*" data-flow-to="([^"]*)" data-flow-key="(\d+)"/g)) {
    const to = m[1], k = Number(m[2]);
    if (!targets.has(to) || slotOf.get(k)! < slotOf.get(targets.get(to)!)!) targets.set(to, k);
  }
  const delays = Array.from({ length: edgeCount }, (_, k) => {
    const d = (slotOf.get(k)! * slot).toFixed(1);
    return `${sel(`[data-flow-key='${k}']`)},${sel(`[data-flow-key='${k}'] > text`)}{animation-delay:${d}s}`;
  }).join('');
  const nodes = Array.from(targets, ([to, k]) => {
    const d = (slotOf.get(k)! * slot).toFixed(1);
    return `${sel(`g[data-node-id='${to}'] > rect:not(.c-mask)`)}{animation:seq-node-${seqId} ${loop}s ease-out infinite;animation-delay:${d}s}`;
  }).join('');
  seqCss =
    `${sel('.a-flow--out')}{animation:seq-out-${seqId} ${loop}s cubic-bezier(.45,0,.55,1) infinite}` +
    `${sel('.a-flow-label > text')}{animation:seq-label-${seqId} ${loop}s ease-out infinite}` +
    delays + nodes +
    `@keyframes seq-out-${seqId}{0%{stroke-dashoffset:.22}${pct(1.1)},100%{stroke-dashoffset:-1}}` +
    `@keyframes seq-label-${seqId}{0%,${pct(1.3)}{fill:var(--flow-ink);font-weight:600}${pct(1.5)},100%{fill:var(--label-base);font-weight:400}}` +
    // the landing node: a brief tint and a thicker edge as the pulse reaches it
    `@keyframes seq-node-${seqId}{0%,${pct(0.95)}{fill:#fff;stroke-width:1.5}${pct(1.15)},${pct(1.5)}{fill:color-mix(in srgb,var(--brand-primary) 9%,#fff);stroke-width:2.5}${pct(2.1)},100%{fill:#fff;stroke-width:1.5}}`;
}
const style = maxWidth ? `max-width:${maxWidth}px;` : undefined;
const svgStyle = svgMaxWidth ? `max-width:${svgMaxWidth}px;margin-inline:auto;` : undefined;
---

<figure
  class:list={['idiagram', inert && 'idiagram--inert', !maxWidth && 'idiagram--band', flow && 'idiagram--flow', extra]}
  data-diagram={slug}
  data-seq={edgeCount ? seqId : undefined}
  data-hrefs={inert ? undefined : JSON.stringify(hrefMap)}
  style={style}
>
  {/* The scroller is this inner box, not the figure, so the edge fade below can sit on
      the figure and stay put while the drawing slides under it. */}
  <div class="dscroll">
    {
      svg ? (
        <div class="diagram-svg" style={svgStyle} set:html={svg} />
      ) : (
        <div class="diagram-placeholder mono">{title ?? slug}</div>
      )
    }
  </div>
  {/* A diagram wider than a phone is cut at the right edge, and a cut with no fade and
      no word reads as a broken picture rather than a scrollable one. */}
  <p class="swipe mono">{UI.swipeDiagram[lang]}</p>
  {seqCss && <style set:html={seqCss} />}
  {!inert && <div class="tip mono" role="status" hidden />}
  {
    explore && (
      <figcaption class="mono cap">
        <a href={exploreHref} target="_blank" rel="noreferrer">{UI.explore[lang]}</a>
        <span class="cap-note">{UI.exploreNote[lang]}</span>
      </figcaption>
    )
  }
</figure>

<script>
  // Flow pulses run only while the figure is on screen; without JavaScript they
  // simply run. Reduced motion hides them outright in diagram.css.
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) (e.target as HTMLElement).dataset.flow = e.isIntersecting ? 'run' : 'paused';
    });
    document.querySelectorAll<HTMLElement>('.idiagram--flow').forEach((f) => io.observe(f));
  }
  type Tip = HTMLElement | null;

  document.querySelectorAll<HTMLElement>('.idiagram[data-hrefs]').forEach((figure) => {
    let hrefs: Record<string, string> = {};
    try {
      hrefs = JSON.parse(figure.dataset.hrefs || '{}');
    } catch {
      return;
    }
    const tip: Tip = figure.querySelector('.tip');

    const show = (node: SVGGElement) => {
      if (!tip) return;
      const bits = [node.dataset.nodeSublabel, node.dataset.nodeTag].filter(Boolean);
      const label = node.dataset.nodeLabel || node.dataset.nodeId || '';
      tip.textContent = bits.length ? `${label} · ${bits.join(' · ')}` : label;
      const box = node.getBoundingClientRect();
      const frame = figure.getBoundingClientRect();
      tip.hidden = false;
      const half = tip.offsetWidth / 2;
      const left = box.left - frame.left + box.width / 2;
      tip.style.left = `${Math.min(Math.max(left, half + 4), frame.width - half - 4)}px`;
      tip.style.top = `${Math.max(box.top - frame.top - tip.offsetHeight - 8, 2)}px`;
    };
    const hide = () => {
      if (tip) tip.hidden = true;
    };

    Object.keys(hrefs).forEach((id) => {
      const node = figure.querySelector<SVGGElement>(`[data-node-id="${id}"]`);
      if (!node) return;
      const href = hrefs[id];

      node.addEventListener('mouseenter', () => show(node));
      node.addEventListener('focus', () => show(node));
      node.addEventListener('mouseleave', hide);
      node.addEventListener('blur', hide);
      node.addEventListener('click', () => {
        window.location.href = href;
      });
      node.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          window.location.href = href;
        }
      });
    });

    figure.addEventListener('mouseleave', hide);
  });
</script>

<style>
  /* The figure is a band of paper, not a boxed illustration (PRD §5): no heavy border,
     nothing between the diagram and the page but air. */
  .idiagram {
    position: relative;
    /* `margin` shorthand would set margin-left:auto and clobber the offset .breakout
       needs; auto margins also shrink-wrap the figure when it is a grid item, and an
       SVG sized only by viewBox then collapses to nothing. */
    margin-block: 2rem 0;
    padding: 0;
    background: none;
  }
  .idiagram--inert .diagram-svg {
    pointer-events: none;
  }

  .cap {
    margin-top: 0.85rem;
    font-size: var(--text-label);
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
  }
  .cap-note {
    font-size: var(--text-label-sm);
    opacity: 0.8;
  }
  .cap a {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .cap a:hover {
    color: var(--ink);
  }

  .tip {
    position: absolute;
    z-index: 3;
    transform: translateX(-50%);
    pointer-events: none;
    background: var(--ink);
    color: var(--surface);
    font-size: var(--text-label-sm);
    letter-spacing: 0.04em;
    line-height: var(--leading-mono);
    padding: 0.35rem 0.6rem;
    border-radius: 2px;
    white-space: nowrap;
    max-width: 90%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tip[hidden] {
    display: none;
  }

  .diagram-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
    border: 1px solid var(--rule);
    color: var(--ink-muted);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Mobile: the diagram keeps its aspect ratio and scrolls sideways in its frame. */

</style>
