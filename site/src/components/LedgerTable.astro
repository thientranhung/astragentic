---
import { entryBody, entryHtml, ledgerHref, type LedgerRow } from '../lib/data';
import { UI, type Lang } from '../lib/site';

interface Props {
  rows: LedgerRow[];
  lang: Lang;
  /** Home caps the table at 60vh and scrolls inside it; /evidence shows it whole. */
  scroll?: boolean;
  /** Row whose drawer is already open on load, so the reader sees what a drawer is. */
  openId?: string;
}
const { rows, lang, scroll = false, openId } = Astro.props;
const uid = `lt-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="ledger breakout" data-ledger id={uid} data-open={openId ?? ''}>
  <div class="bar">
    <input
      class="filter mono"
      type="search"
      data-filter
      placeholder={UI.filter[lang]}
      aria-label={UI.filter[lang]}
    />
    <p class="count mono" data-count>{rows.length} / {rows.length} {UI.rowsShown[lang]}</p>
  </div>

  <div class:list={['scroller', scroll && 'scroller--capped']}>
    <table class="table">
      <thead>
        <tr>
          <th class="mono c-id">{UI.colId[lang]}</th>
          <th class="mono c-lesson" lang="en">{UI.colLesson[lang]}</th>
          <th class="mono c-status" lang="en">{UI.colStatus[lang]}</th>
          <th class="mono c-cited" lang="en">{UI.colCited[lang]}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => {
            const slug = row.id.toLowerCase();
            const hasRefs = row.refs.length > 0 || row.citedBy.length > 0;
            const search = `${row.id} ${row.lesson}`.toLowerCase();
            return (
              <>
                <tr
                  class:list={['row', hasRefs ? 'row--cited' : 'row--orphan']}
                  id={slug}
                  data-row={slug}
                  data-search={search}
                  data-has-refs={hasRefs ? 'yes' : 'no'}
                  tabindex={hasRefs ? 0 : undefined}
                  role={hasRefs ? 'button' : undefined}
                  aria-expanded={hasRefs ? 'false' : undefined}
                  aria-controls={hasRefs ? `${uid}-${slug}` : undefined}
                  title={hasRefs ? undefined : UI.noRefs[lang]}
                >
                  <td class="mono c-id">{row.id}</td>
                  <td class="c-lesson" lang="en" set:html={entryHtml(row.lesson)} />
                  <td class="mono c-status" lang="en">{row.status}</td>
                  <td class="mono c-cited">
                    {hasRefs ? (
                      <span class="hit">
                        <span class="arrow">→</span> {row.refs.length || row.citedBy.length}
                      </span>
                    ) : (
                      <span class="dash" aria-label={UI.noRefs[lang]}>—</span>
                    )}
                  </td>
                </tr>
                {hasRefs && (
                  <tr class="drawer" id={`${uid}-${slug}`} data-drawer={slug} hidden>
                    <td colspan="4">
                      <div class="drawer-in">
                        <p class="drawer-title mono" lang="en">
                          {row.id} — {row.lesson}
                          {row.promotedOn ? ` · promoted ${row.promotedOn}` : ''}
                        </p>
                        <blockquote class="drawer-entry mono" lang="en" set:html={entryHtml(entryBody(row))} />
                        <p class="drawer-label mono">{UI.carriedBy[lang]}</p>
                        <ul class="refs">
                          {(row.refs.length ? row.refs : row.citedBy.map((n) => ({ name: n, kind: 'file' as const, href: null }))).map((ref) => (
                            <li>
                              {ref.href ? (
                                <a
                                  href={ref.href}
                                  class="ref mono"
                                  target={ref.kind === 'file' ? '_blank' : undefined}
                                  rel={ref.kind === 'file' ? 'noreferrer' : undefined}
                                >
                                  {ref.name} {ref.kind === 'skill' ? '↓' : '↗'}
                                </a>
                              ) : (
                                <span class="ref-dead mono">{ref.name}</span>
                              )}
                            </li>
                          ))}
                        </ul>
                        {row.commits && row.commits.length > 0 && (
                          <>
                            <p class="drawer-label mono">{lang === 'vi' ? 'Commit đóng nó' : 'Closed by commit'}</p>
                            <ul class="drawer-refs">
                              {row.commits.map((c) => (
                                <li>
                                  <a
                                    href={`https://github.com/thientranhung/astragentic/commit/${c.sha}`}
                                    class="ref mono"
                                    target="_blank"
                                    rel="noreferrer"
                                  >
                                    {c.sha.slice(0, 7)} · {c.date} ↗
                                  </a>
                                  <span class="commit-subject">{c.subject}</span>
                                </li>
                              ))}
                            </ul>
                          </>
                        )}
                        <p class="drawer-src mono">
                          <a href={ledgerHref(row)} target="_blank" rel="noreferrer">
                            recurring-failure-modes.md:{row.entryLine} ↗
                          </a>
                        </p>
                      </div>
                    </td>
                  </tr>
                )}
              </>
            );
          })
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  // Vanilla, no framework: one delegated click handler, one input handler, per table.
  document.querySelectorAll<HTMLElement>('[data-ledger]').forEach((root) => {
    const total = root.querySelectorAll('[data-row]').length;
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const countTail = countEl?.textContent?.replace(/^\s*\d+\s*\/\s*\d+\s*/, '') ?? '';

    const drawerFor = (slug: string) =>
      root.querySelector<HTMLElement>(`[data-drawer="${CSS.escape(slug)}"]`);

    function toggle(rowEl: HTMLElement, force?: boolean) {
      const slug = rowEl.dataset.row!;
      const drawer = drawerFor(slug);
      if (!drawer) return;
      const open = force ?? drawer.hasAttribute('hidden');
      if (open) drawer.removeAttribute('hidden');
      else drawer.setAttribute('hidden', '');
      rowEl.setAttribute('aria-expanded', String(open));
      rowEl.classList.toggle('row--open', open);
    }

    root.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target.closest('a')) return; // links inside a drawer win
      const rowEl = target.closest<HTMLElement>('[data-row]');
      if (!rowEl || rowEl.dataset.hasRefs !== 'yes') return;
      toggle(rowEl);
    });

    root.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key !== 'Enter' && key !== ' ') return;
      const rowEl = (event.target as HTMLElement).closest<HTMLElement>('[data-row]');
      if (!rowEl || rowEl.dataset.hasRefs !== 'yes') return;
      event.preventDefault();
      toggle(rowEl);
    });

    const filter = root.querySelector<HTMLInputElement>('[data-filter]');
    filter?.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      let shown = 0;
      root.querySelectorAll<HTMLElement>('[data-row]').forEach((rowEl) => {
        const hit = !q || (rowEl.dataset.search ?? '').includes(q);
        rowEl.hidden = !hit;
        const drawer = drawerFor(rowEl.dataset.row!);
        if (drawer && !hit) {
          drawer.setAttribute('hidden', '');
          rowEl.setAttribute('aria-expanded', 'false');
          rowEl.classList.remove('row--open');
        }
        if (hit) shown += 1;
      });
      if (countEl) countEl.textContent = `${shown} / ${total} ${countTail}`;
    });

    // Open the row the page asked for, then the row the URL asked for. A deep link
    // from another page (/#ast-016 → /bang-chung#ast-016) must land on an open drawer.
    const preset = root.dataset.open;
    if (preset) {
      const rowEl = root.querySelector<HTMLElement>(`[data-row="${CSS.escape(preset.toLowerCase())}"]`);
      if (rowEl) {
        toggle(rowEl, true);
        // Scroll the table, never the page: the reader has not asked to move yet.
        const scroller = root.querySelector<HTMLElement>('.scroller--capped');
        if (scroller) scroller.scrollTop = Math.max(0, rowEl.offsetTop - 84);
      }
    }
    const fromHash = () => {
      const slug = decodeURIComponent(location.hash.replace(/^#/, '')).toLowerCase();
      if (!slug) return;
      const rowEl = root.querySelector<HTMLElement>(`[data-row="${CSS.escape(slug)}"]`);
      if (!rowEl || rowEl.dataset.hasRefs !== 'yes') return;
      toggle(rowEl, true);
      rowEl.scrollIntoView({ block: 'center' });
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  });
</script>

<style>
  .ledger {
    margin-block: 2.5rem 0;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }
  .filter {
    flex: 1 1 260px;
    max-width: 360px;
    font-size: var(--text-mono);
    padding: 0.55rem 0.7rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink);
  }
  .filter:focus {
    outline: none;
    border-color: var(--ink);
  }
  .count {
    font-size: var(--text-label-sm);
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin: 0;
  }

  .scroller {
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--rule);
    background: var(--surface);
  }
  .scroller--capped {
    max-height: 60vh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--surface);
    text-align: left;
    font-weight: 500;
    font-size: var(--text-label-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  td {
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--rule-faint);
    vertical-align: top;
  }
  .c-id {
    width: 96px;
    font-size: var(--text-mono);
  }
  .c-status {
    width: 110px;
    font-size: var(--text-label);
    color: var(--ink-muted);
  }
  .c-cited {
    width: 76px;
    font-size: var(--text-mono);
    text-align: right;
    padding-right: 0.25rem;
  }
  .c-lesson {
    font-size: var(--text-body-sm);
    line-height: 1.35;
  }

  .row--cited {
    cursor: pointer;
  }
  .row--cited:hover td {
    background: var(--paper-sunk);
  }
  .row--cited:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .row--open td {
    background: var(--paper-sunk);
  }
  .row--open .arrow {
    transform: rotate(90deg);
    display: inline-block;
  }
  /* One per row, forty rows: a count is data, not a signal, so it does not get the
     brand. The bar down the opened drawer does — that one is "the row you are on". */
  .hit {
    color: var(--ink);
    white-space: nowrap;
  }
  .row--orphan .c-lesson,
  .row--orphan .c-id {
    color: var(--ink-muted);
  }
  .dash {
    color: color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .row--orphan:hover td {
    background: var(--rule-faint);
  }

  .drawer td {
    background: var(--paper-sunk);
    border-bottom: 1px solid var(--rule);
    padding: 0;
  }
  .drawer-in {
    padding: 1.15rem 1.25rem 1.25rem;
    border-left: 2px solid var(--brand-primary);
  }
  .drawer-title {
    font-size: var(--text-label);
    letter-spacing: 0.03em;
    color: var(--ink-muted);
    margin: 0 0 0.65rem;
  }
  .drawer-entry {
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
    font-size: var(--text-mono);
    line-height: 1.6;
    white-space: pre-wrap;
  }
  .drawer-label {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin: 0 0 0.4rem;
  }
  .refs {
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }
  .refs li {
    margin: 0;
  }
  .ref {
    font-size: var(--text-mono);
    color: var(--pass);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--pass) 40%, transparent);
  }
  .ref:hover {
    border-bottom-color: var(--pass);
  }
  .ref-dead {
    font-size: var(--text-mono);
    color: var(--ink-muted);
  }
  .commit-subject {
    display: block;
    font-size: var(--text-ui);
    color: var(--ink-muted);
    margin-top: 0.15rem;
  }

  .drawer-src {
    margin: 0;
    font-size: var(--text-label-sm);
  }
  .drawer-src a {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  @media (max-width: 700px) {
    .c-status {
      display: none;
    }
    .c-id {
      width: 78px;
    }
  }
</style>
