---
import Wordmark from './Wordmark.astro';
// Seven destinations, plus the two that are not destinations: the language toggle and
// the repository. Those two used to read as nav items, which made the bar look like ten
// places to go. The toggle is one control now, and the repository is an icon with a
// label a screen reader still gets.
import LangSwitch from './LangSwitch.astro';
import { NAV, ROUTES, REPO, UI, type Lang, type PageKey } from '../lib/site';

interface Props {
  lang: Lang;
  page?: PageKey;
  /** Off-table pages (role pages) hand their own vi/en pair to the switch. */
  alternate?: Record<Lang, string>;
}
const { lang, page, alternate } = Astro.props;
---

<header class="nav-bar">
  <nav class="column-wide nav">
    <Wordmark href={ROUTES.home[lang]} tag="by Astraler" />
    {/* One list, two shapes. Above 860px the <details> is display:contents, so the
        links are grid items on the bar exactly as before. Below it the summary becomes
        a button and the same list drops as a panel — the seven destinations do not
        shrink, the bar does. It ships open so a reader with scripting off still has
        navigation; the script below closes it once we know the screen is narrow, the
        same contract SiteNav runs on. */}
    <details class="menu" open>
      <summary class="menu-btn mono" aria-label={UI.menu[lang]}>
        <span class="menu-word">{UI.menu[lang]}</span>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <ul class="items">
        {
          NAV.map((item) => (
            <li>
              <a href={ROUTES[item.key][lang]} class={item.key === page ? 'on' : undefined}>
                {item.label[lang]}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    <div class="right">
      {(page || alternate) && <LangSwitch lang={lang} page={page} hrefs={alternate} />}
      <a href={REPO} target="_blank" rel="noreferrer" class="gh" aria-label={UI.repoAria[lang]}>
        {/* GitHub's own mark, drawn as a path — no glyph standing in for an icon. */}
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  /* The bar ships with its menu open, which is the right state on a wide screen, where
     the summary is not drawn and the list is the bar itself. Below the breakpoint the
     list is a panel, so close it as soon as we know the width. Escape and a tap outside
     close it too; a tap on a link needs no handler because the page navigates away. */
  (function () {
    var menu = document.querySelector('.nav-bar .menu');
    if (!menu) return;
    var wide = window.matchMedia('(min-width: 861px)');
    var sync = function () {
      menu.open = wide.matches;
    };
    sync();
    wide.addEventListener('change', sync);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && menu.open && !wide.matches) {
        menu.open = false;
        var btn = menu.querySelector('summary');
        if (btn) btn.focus();
      }
    });
    document.addEventListener('click', function (e) {
      if (!wide.matches && menu.open && !menu.contains(e.target)) menu.open = false;
    });
  })();
</script>

<style>
  /* 56px, sticky: the two rails in Read mode hang off the bottom of this bar, so its
     height is a measurement, not a taste (design spec 5 §2). */
  /* aihero's header is white and the ground under the page is not: the bar is the top
     edge of the reading surface, not another band of canvas. */
  .nav-bar {
    border-bottom: 1px solid var(--ink-10);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  /* Three columns of 1fr · auto · 1fr so the menu sits on the island's true centre line,
     not in the leftover space between the wordmark and the language toggle. */
  /* The bar spans the island on every page, home and docs alike, with one gutter, so the
     wordmark and the language toggle sit at the same distance from the island's edge no
     matter how wide the frame under it is. Before, the inner column was capped at
     1040px and floated in a 1440px docs island, so the wordmark jumped ~200px between
     pages. */
  .nav {
    max-width: none;
    padding-inline: clamp(1rem, 2.5vw, 1.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: 1.25rem;
    height: var(--header-h);
    padding-block: 0;
  }
  .nav > .right {
    justify-self: end;
  }
  .nav > .items {
    justify-content: center;
  }
  .wordmark {
    font-family: var(--font-mono);
    font-size: var(--text-ui);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    min-width: 0;
    overflow: hidden;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .items li {
    margin: 0;
  }
  .items a {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 0 0.15rem;
    min-height: var(--row-h);
    line-height: 1.2;
    /* equal transparent rules top and bottom so the label's optical centre stays on the
       bar's centre line; only the bottom one ever takes colour */
    border-top: 2px solid transparent;
    border-bottom: 2px solid transparent;
  }
  .items a:hover {
    color: var(--ink);
  }
  /* Where you are: full ink, and a 2px brand rule under the word. The colour is the
     mark, the ink is the reading — the label never has to be red to be legible. */
  .items a.on {
    color: var(--ink);
    border-bottom-color: var(--brand-primary);
  }
  .right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -0.6rem;
    color: var(--ink-muted);
  }
  .gh:hover {
    color: var(--ink);
  }
  .gh svg {
    display: block;
  }

  /* The disclosure is inert above the breakpoint: display:contents dissolves it,
     so the list below is a grid item on the bar and nothing about the wide layout
     changes. */
  .menu {
    display: contents;
  }
  .menu-btn {
    display: none;
  }

  /* Below the breakpoint the bar used to wrap the links onto a second row. Measured
     across the range, that second row is itself two rows from 830px down, so the bar
     stood 141px tall — 17% of a 393x852 phone, charged again on every scroll because
     the bar is sticky. The links do not get smaller here, the bar does: the same list
     becomes a panel under a 52px row, and the whole range behaves one way. */
  @media (max-width: 860px) {
    .nav {
      grid-template-columns: minmax(0, 1fr) auto auto;
      row-gap: 0;
      column-gap: 0.55rem;
      height: var(--header-h);
      padding-block: 0;
    }
    .wordmark,
    .right,
    .menu {
      grid-area: auto;
    }
    .right {
      justify-self: end;
      gap: 0.35rem;
    }
    .gh {
      width: 40px;
      height: 40px;
      margin-right: -0.45rem;
    }

    .menu {
      display: block;
      justify-self: end;
    }
    .menu-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      height: 40px;
      padding-inline: 0.6rem;
      border: 1px solid var(--ink-10);
      border-radius: var(--radius-badge);
      font-size: var(--text-label);
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: var(--ink-muted);
      cursor: pointer;
      list-style: none;
    }
    .menu-btn::-webkit-details-marker {
      display: none;
    }
    .menu[open] .menu-btn {
      color: var(--ink);
      border-color: var(--ink-22);
      background: var(--surface-2);
    }
    /* Three rules, not a glyph: the button has a word next to it, so the mark only has
       to say "this opens", and it turns into a cross to say "this closes". */
    .bars {
      display: grid;
      gap: 3px;
      width: 14px;
    }
    .bars i {
      display: block;
      height: 1.5px;
      background: currentColor;
      transition: transform var(--motion-drawer, 160ms) var(--ease-out, ease);
    }
    .menu[open] .bars i:nth-child(1) {
      transform: translateY(4.5px) rotate(45deg);
    }
    .menu[open] .bars i:nth-child(2) {
      transform: scaleX(0);
    }
    .menu[open] .bars i:nth-child(3) {
      transform: translateY(-4.5px) rotate(-45deg);
    }

    .items {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      display: block;
      gap: 0;
      overflow: auto;
      max-height: calc(100dvh - var(--header-h));
      padding: 0.35rem clamp(1rem, 2.5vw, 1.75rem) 0.9rem;
      background: var(--surface);
      border-bottom: 1px solid var(--ink-10);
      box-shadow: 0 14px 28px -18px rgb(17 17 17 / 28%);
    }
    .items li + li {
      border-top: 1px solid var(--rule);
    }
    .items a {
      display: flex;
      min-height: 46px;
      padding: 0.1rem 0.15rem;
      border-top: 0;
      border-bottom: 0;
      box-shadow: none;
    }
    /* The bar under a word does not read as "you are here" in a stacked list, where
       every row already has a rule above it. The mark moves to the left edge. */
    .items a.on {
      color: var(--brand-primary-hover);
      margin-inline: calc(-1 * clamp(1rem, 2.5vw, 1.75rem));
      padding-inline: clamp(1rem, 2.5vw, 1.75rem);
      background: var(--brand-primary-soft);
      box-shadow: inset 2px 0 0 var(--brand-primary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bars i {
      transition: none;
    }
  }
</style>
