---
// /tips · /vi/kinh-nghiem — the four techniques a machine needs before several agents
// can run on it at once. Read mode (design spec 5 §2).
//
// Every other page describes Astragentic. This one describes the ground it stands on,
// which is why it is the only page whose sections are tools the project does not ship.
// The writer owns the prose in src/content/pages/<lang>/tips.md, split by the ids
// in TIPS plus a closing `## one-shape`.
import DocsLayout from '../../layouts/DocsLayout.astro';
import Prose from '../Prose.astro';
import { getPage } from '../../lib/pages';
import { TIPS } from '../../lib/anchors';
import { UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'tips');

const heading =
  lang === 'vi'
    ? 'git worktree cô lập code, không cô lập runtime'
    : 'git worktree isolates code, not runtime';
---

<DocsLayout
  title={page.missing ? UI.tipsTitle[lang] : page.title}
  description={page.description}
  lang={lang}
  page="tips"
  eyebrow={UI.tipsTitle[lang]}
  heading={heading}
>
  {page.intro && <Prose slot="lede" html={page.intro} class="lede" />}

  {
    TIPS.map((item) => (
      <section class="read-section" id={item.id}>
        {/* The role label carries the argument: which of the four this is, and why it
            sits here rather than in a flat list of tips. */}
        <p class="parts-label mono">{item.role[lang]}</p>
        <h2 class="name">{item.name}</h2>
        {/* The one-liner is the rail's summary of this section. It stands on the page
            only until the writer's prose lands, or it says the same thing twice. */}
        {page.sections[item.id] ? (
          <Prose html={page.sections[item.id]} class="read-body read-body--sections body" />
        ) : (
          <p class="line">{item.line[lang]}</p>
        )}
      </section>
    ))
  }

  {
    page.sections['one-shape'] && (
      <section class="read-section" id="one-shape">
        <h2>{lang === 'vi' ? 'Một hình dạng chung' : 'One shape'}</h2>
        <Prose html={page.sections['one-shape']} class="read-body read-body--sections body" />
      </section>
    )
  }
</DocsLayout>

<style>
  /* This page carries five sections and eleven headings under them, so the ladder has
     to be read at a glance. It was not: the section head sat at 19px against 17px of
     body, the label above it at 17px competed with it, and the subsection heads under
     it rendered at 14px — smaller than the paragraph they introduced. The rungs are the
     docs pages' own: 10px label, 26px section, 19px subsection, 17px body.
     Sans, not mono: only two of the section names are literal tool names, and a tool
     name inside the prose already gets the mono face from its backticks. */
  .parts-label {
    font-size: var(--text-micro);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.5rem;
  }
  .name {
    font-size: var(--text-h2);
  }
  .line {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 64ch;
    margin: 0.35rem 0 0;
  }
  .body {
    margin-top: 1.25rem;
  }
</style>
