---
// /why · /vi/vi-sao — five questions, one anchored section each (build spec 4 §3), in
// Read mode (design spec 5 §2). The list of five that used to open the page is gone:
// the "On this page" rail is that list, and it stays on screen while you read.
import DocsLayout from '../../layouts/DocsLayout.astro';
import Diagram from '../Diagram.astro';
import RoleKey from '../RoleKey.astro';
import Prose from '../Prose.astro';
import { getPage } from '../../lib/pages';
import { WHY } from '../../lib/anchors';
import { UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'why');
const heading =
  lang === 'vi' ? 'Năm quyết định thiết kế' : 'Five design decisions';

/** One picture per answer, all of them diagrams that already exist elsewhere on the
 *  site — the same drawing the reader met on the landing page or the structure page,
 *  reused where the argument needs it (PRD §5: every section carries a picture). */
const FIGURE: Record<string, string> = {
  'why-astragentic': 'structure',
  'why-mattpocock': 'layer-map',
  'why-not-subagents': 'hub-and-spokes',
  'why-tracker': 'frontier-query',
  'why-cross-vendor': 'cross-vendor-arm',
};
/** The figures that carry roles get the role key under them (design spec 5 §3). */
const KEYED = new Set(['hub-and-spokes', 'cross-vendor-arm', 'frontier-query', 'structure']);
---

<DocsLayout
  title={page.missing ? UI.whyTitle[lang] : page.title}
  description={page.description}
  lang={lang}
  page="why"
  eyebrow={UI.whyTitle[lang]}
  heading={page.missing ? heading : page.title}
>
  {page.intro && <Prose slot="lede" html={page.intro} class="lede" />}

  {
    WHY.map((why) => (
      <section class="read-section" id={why.id}>
        <h2>{why.question[lang]}</h2>
        {page.sections[why.id] ? (
          <Prose html={page.sections[why.id]} class="read-body body" />
        ) : (
          <p class="answer">{why.answer[lang]}</p>
        )}
        {FIGURE[why.id] && (
          <div class="figure">
            <Diagram slug={FIGURE[why.id]} lang={lang} frame={860} />
            {KEYED.has(FIGURE[why.id]) && <RoleKey lang={lang} />}
          </div>
        )}
      </section>
    ))
  }
</DocsLayout>

<style>
  .answer {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 64ch;
    margin: 0;
  }
  .body {
    margin-top: 0.5rem;
  }
  /* aihero-style reading rhythm: a run-in subhead every few paragraphs, lists where the
     text enumerates, and a bold lead-in carrying the point of each item. */
  .body :global(h3) {
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    margin: 2.2rem 0 0.8rem;
  }
  .body :global(ul) {
    margin: 0 0 1.6rem;
    padding-left: 1.1rem;
    list-style: disc;
    max-width: 72ch;
  }
  .body :global(li) {
    margin-bottom: 0.7rem;
  }
  .body :global(li)::marker {
    color: var(--ink-22);
  }
  .body :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }
  /* A compare table reads faster than the same contrast written as prose; the first
     column carries the aspect, so it is the one that gets the weight. */
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4rem 0 1.6rem;
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }
  .body :global(th),
  .body :global(td) {
    border-bottom: 1px solid var(--ink-10);
    padding: 0.7rem 1.5rem 0.7rem 0;
    text-align: left;
    vertical-align: top;
  }
  .body :global(th:last-child),
  .body :global(td:last-child) {
    padding-right: 0;
  }
  .body :global(table + p) {
    margin-top: 1.6rem;
  }
  .body :global(thead th) {
    font-size: var(--text-label-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: 600;
  }
  .body :global(tbody td:first-child) {
    color: var(--ink);
    font-weight: 600;
    width: 24%;
  }
  .body :global(tbody td:nth-child(2)) {
    color: var(--ink-muted);
  }
  .figure {
    margin-top: 1rem;
  }
</style>
