---
// /vi-sao · /en/why — five questions, one anchored section each (build spec 4 §3).
// The writer owns src/content/pages/<lang>/why.md, split by `## why-astragentic`,
// `## why-mattpocock`, `## why-not-subagents`, `## why-tracker`, `## why-cross-vendor`.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Diagram from '../Diagram.astro';
import Prose from '../Prose.astro';
import { getPage } from '../../lib/pages';
import { WHY } from '../../lib/anchors';
import { UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'why');
const heading =
  lang === 'vi' ? 'Năm câu mình phải tự trả lời trước' : 'Five questions I had to answer first';

/** One picture per answer, all of them diagrams that already exist elsewhere on the
 *  site — the same drawing the reader met on the landing page or the structure page,
 *  reused where the argument needs it (PRD §5: every section carries a picture). */
const FIGURE: Record<string, string> = {
  'why-astragentic': 'structure',
  'why-mattpocock': 'layer-map',
  'why-not-subagents': 'hub-and-spokes',
  'why-tracker': 'frontier-query',
  'why-cross-vendor': 'cross-vendor-arm',
};
---

<BaseLayout
  title={page.missing ? UI.whyTitle[lang] : page.title}
  description={page.description}
  lang={lang}
  page="why"
>
  <section class="screen screen--paper">
    <div class="column">
      <p class="eyebrow">{UI.whyTitle[lang]}</p>
      <h1>{page.missing ? heading : page.title}</h1>
      {page.intro && <Prose html={page.intro} lead />}
      <ol class="toc">
        {
          WHY.map((why, i) => (
            <li>
              <a href={`#${why.id}`}>
                <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
                <span>{why.question[lang]}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    WHY.map((why, i) => (
      <section class:list={['screen', i % 2 === 0 ? 'screen--sunk' : 'screen--paper']} id={why.id}>
        <div class="column">
          <p class="eyebrow mono">{String(i + 1).padStart(2, '0')}</p>
          <h2>{why.question[lang]}</h2>
          {FIGURE[why.id] && <Diagram slug={FIGURE[why.id]} lang={lang} class="band" />}
          {page.sections[why.id] ? (
            <Prose html={page.sections[why.id]} class="body" />
          ) : (
            <p class="answer">{why.answer[lang]}</p>
          )}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  .toc {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .toc li {
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }
  .toc a {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.7rem 0.25rem;
    font-size: 17px;
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--pass);
  }
  .toc .n {
    font-size: 11px;
    color: var(--rule);
    letter-spacing: 0.1em;
  }
  .answer {
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 64ch;
    margin: 0;
  }
  .body :global(p),
  .body :global(li) {
    max-width: 68ch;
  }
</style>
