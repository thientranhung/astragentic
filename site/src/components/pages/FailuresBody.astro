---
// /loi · /en/failures — the six measured failures, grouped by the stage they happened
// at, in Read mode (design spec 5 §2). The two acts of prose that opened the pass-2
// home page live here (landing spec §2).
import DocsLayout from '../../layouts/DocsLayout.astro';
import DefectCard from '../DefectCard.astro';
import Prose from '../Prose.astro';
import { getPage, act } from '../../lib/pages';
import { byId, failures } from '../../lib/data';
import { ROUTES, UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'failures');
const home = await getPage(lang, 'home');

// Grouped by stage, not by failure, because the home diagram links straight at
// `#claim`, `#brief`, … Every stage gets an anchor, including the three that carry no
// measured failure — an empty stage that cannot be linked to reads as an omission
// rather than as an admission.
const ORDER = ['claim', 'brief', 'build', 'code-review', 'simplify', 'arm', 'merge'];
const perStage = ORDER.map((stage) => ({
  stage,
  items: failures.filter((f) => f.stage === stage),
}));
---

<DocsLayout
  title={page.title}
  description={page.description}
  lang={lang}
  page="failures"
  eyebrow={lang === 'vi' ? 'sáu lỗi · đo được, có ngày, có trích' : 'six failures · measured, dated, cited'}
>
  <Prose slot="lede" html={page.intro} class="lede" />

  {
    (home.sections['act-1'] || home.sections['act-2']) && (
      <section class="read-section" id="act-1">
        {act(home, 'act-1').headline && <h2>{act(home, 'act-1').headline}</h2>}
        <Prose html={home.sections['act-1'] ?? ''} lead class="read-body" />
        <div class="act-2" id="act-2">
          {act(home, 'act-2').headline && <h2>{act(home, 'act-2').headline}</h2>}
          <Prose html={home.sections['act-2'] ?? ''} class="read-body" />
        </div>
      </section>
    )
  }

  {
    perStage.map(({ stage, items }) => (
      <section class="read-section" id={stage}>
        <h2 class="mono stage" lang="en">{stage}</h2>
        {items.length === 0 ? (
          <p class="empty mono">{UI.emptyStage[lang]}</p>
        ) : (
          items.map((failure) => {
            const row = byId.get(failure.id);
            const slug = failure.id.toLowerCase();
            return row ? (
              <div class="item">
                <DefectCard
                  row={row}
                  lang={lang}
                  size="lg"
                  costLine={failure.costLine}
                  anchorId={slug}
                  href={`${ROUTES.evidence[lang]}#${slug}`}
                />
                <div class="prose-under">
                  <Prose html={page.sections[slug] ?? ''} class="read-body" />
                </div>
              </div>
            ) : null;
          })
        )}
      </section>
    ))
  }

  <p class="tail">
    <a class="more-link" href={ROUTES.evidence[lang]}>{UI.wholeTable[lang]}</a>
  </p>
</DocsLayout>

<style>
  .act-2 {
    margin-top: 2rem;
  }
  .stage {
    font-size: var(--text-body-sm);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.9rem;
  }
  .empty {
    font-size: var(--text-label);
    color: var(--ink-muted);
    margin: 0;
  }
  .item + .item {
    margin-top: 2rem;
  }
  .prose-under {
    margin-top: 1.25rem;
  }
  .tail {
    margin: 0;
  }
</style>
