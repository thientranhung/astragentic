---
// /tech-stack · /vi/tech-stack — eight pieces, one anchored section each (build spec 4
// §3), in Read mode (design spec 5 §2). The chip rail that used to sit above the
// sections is gone: the right-hand rail is the same eight names and it stays put.
import DocsLayout from '../../layouts/DocsLayout.astro';
import Figure from '../Figure.astro';
import Prose from '../Prose.astro';
import { getPage } from '../../lib/pages';
import { STACK } from '../../lib/anchors';
import { UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'tech-stack');
const heading =
  lang === 'vi'
    ? 'Tám thành phần của stack, và vì sao là chúng'
    : 'Eight components in the stack, and why these';

/** git worktree is a set of parallel lanes; the drawing shows them. */
const FIGURE: Record<string, string> = {
  'git-worktree': 'parallel-lanes',
};
---

<DocsLayout
  harness={page.harness}
  title={page.missing ? UI.stackTitle[lang] : page.title}
  description={page.description}
  lang={lang}
  page="stack"
  eyebrow={UI.stackTitle[lang]}
  heading={page.missing ? heading : page.title}
>
  {page.intro && <Prose slot="lede" html={page.intro} class="lede" />}

  <div class="figure" data-toc-skip>
    {/* The whole stack at once, before the eight sections take it apart. */}
    <Figure slug="layer-map" lang={lang} />
  </div>

  {
    STACK.map((item) => (
      <section class="read-section" id={item.id}>
        <p class="need mono">{item.required ? UI.stackRequired[lang] : UI.stackOptional[lang]}</p>
        <h2 class="mono item-name" lang="en">{item.name}</h2>
        {page.sections[item.id] ? (
          <Prose html={page.sections[item.id]} class="read-body body" />
        ) : (
          <p class="line">{item.line[lang]}</p>
        )}
        {FIGURE[item.id] && <Figure slug={FIGURE[item.id]} lang={lang} />}
      </section>
    ))
  }
</DocsLayout>

<style>
  .figure {
    margin-block: 1.5rem 0;
  }
  .need {
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.3rem;
  }
  .item-name {
    font-size: var(--text-h3);
    letter-spacing: -0.005em;
  }
  .line {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 64ch;
    margin: 0.4rem 0 0;
  }
  .body {
    margin-top: 0.5rem;
  }
</style>
