---
// /tech-stack · /en/tech-stack — nine pieces, one anchored section each (build spec 4
// §3), in Read mode (design spec 5 §2). The chip rail that used to sit above the
// sections is gone: the right-hand rail is the same nine names and it stays put.
import DocsLayout from '../../layouts/DocsLayout.astro';
import Diagram from '../Diagram.astro';
import Prose from '../Prose.astro';
import { getPage } from '../../lib/pages';
import { STACK } from '../../lib/anchors';
import { UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'tech-stack');
const heading = lang === 'vi' ? 'Chín thứ, và vì sao là chúng' : 'Nine pieces, and why these';

/** Two of the nine pieces are shapes, not products: herdr is a hub with one pane per
 *  spoke, and git worktree is a set of parallel lanes. Both drawings already exist. */
const FIGURE: Record<string, string> = {
  herdr: 'hub-and-spokes',
  'git-worktree': 'parallel-lanes',
};
---

<DocsLayout
  title={page.missing ? UI.stackTitle[lang] : page.title}
  description={page.description}
  lang={lang}
  page="stack"
  eyebrow={UI.stackTitle[lang]}
  heading={page.missing ? heading : page.title}
>
  {page.intro && <Prose slot="lede" html={page.intro} class="lede" />}

  <div class="figure" data-toc-skip>
    {/* The whole stack at once, before the nine sections take it apart. */}
    <Diagram slug="layer-map" lang={lang} frame={860} />
  </div>

  {
    STACK.map((item) => (
      <section class="read-section" id={item.id}>
        <p class="need mono">{item.required ? UI.stackRequired[lang] : UI.stackOptional[lang]}</p>
        <h2 class="mono item-name" lang="en">{item.name}</h2>
        {page.sections[item.id] ? (
          <Prose html={page.sections[item.id]} class="read-body body" />
        ) : (
          <p class="line">{item.line[lang]}</p>
        )}
        {FIGURE[item.id] && <Diagram slug={FIGURE[item.id]} lang={lang} frame={860} />}
      </section>
    ))
  }
</DocsLayout>

<style>
  .figure {
    margin-block: 1.5rem 0;
  }
  .need {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.3rem;
  }
  .item-name {
    font-size: 20px;
    letter-spacing: -0.005em;
  }
  .line {
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 64ch;
    margin: 0.4rem 0 0;
  }
  .body {
    margin-top: 0.5rem;
  }
</style>
