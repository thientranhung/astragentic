---
// /hooks · /en/hooks — four hooks, one anchored section each (build spec 4 §3), now in
// Read mode (design spec 5 §2): the four are 3rem apart under one hairline each, not
// four full screens of alternating ground.
import DocsLayout from '../../layouts/DocsLayout.astro';
import Diagram from '../Diagram.astro';
import Prose from '../Prose.astro';
import { getPage } from '../../lib/pages';
import { HOOKS } from '../../lib/anchors';
import { byId } from '../../lib/data';
import { ROUTES, REPO, UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'hooks');
const evidenceRoute = ROUTES.evidence[lang];

const heading =
  lang === 'vi'
    ? 'Bốn hook chạy ở bốn thời điểm cố định'
    : 'Four hooks fire at four fixed moments';
const lede =
  lang === 'vi'
    ? 'Hook là phần duy nhất trong harness chạy mà không agent nào phải nhớ gọi nó.'
    : 'A hook is the one part of the harness that runs without an agent remembering to run it.';
---

<DocsLayout
  title={page.missing ? UI.hooksTitle[lang] : page.title}
  description={page.missing ? lede : page.description}
  lang={lang}
  page="hooks"
  eyebrow={UI.hooksTitle[lang]}
  heading={page.missing ? heading : page.title}
  lede={page.intro ? undefined : lede}
>
  {page.intro && <Prose slot="lede" html={page.intro} class="lede" />}

  {
    HOOKS.map((hook) => {
      const row = byId.get(hook.ast);
      return (
        <section class="read-section" id={hook.id}>
          <p class="event mono" lang="en">{hook.event}</p>
          <h2 class="mono hook-name" lang="en">{hook.script ?? 'settings.json'}</h2>
          <dl class="facts">
            <div>
              <dt class="mono">{UI.hookWhen[lang]}</dt>
              <dd>{hook.when[lang]}</dd>
            </div>
            <div>
              <dt class="mono">{UI.hookEffect[lang]}</dt>
              <dd>{hook.effect[lang]}</dd>
            </div>
          </dl>
          <div class="figure" data-toc-skip>
            <Diagram slug={`hook-${hook.id}`} lang={lang} frame={860} />
          </div>
          {page.sections[hook.id] && <Prose html={page.sections[hook.id]} class="read-body body" />}
          <p class="src mono">
            {hook.script && (
              <a href={`${REPO}/blob/main/harness/${hook.script}`} target="_blank" rel="noreferrer">
                {`harness/${hook.script} ↗`}
              </a>
            )}
            <a class="ast" href={`${evidenceRoute}#${hook.ast.toLowerCase()}`}>{hook.ast}</a>
            {row && <span class="lesson" lang="en">{row.lesson}</span>}
          </p>
        </section>
      );
    })
  }
</DocsLayout>

<style>
  .figure {
    margin-block: 1.5rem 0;
  }
  .event {
    font-size: var(--text-label-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.3rem;
  }
  .hook-name {
    font-size: var(--text-h3);
    letter-spacing: -0.005em;
  }
  /* Same row table as the skills catalog, same numbers: a 200px label column, a
     description capped at 62ch, 24px between them, 12px above and below each row, and
     the whole thing stopping at 860px. Two pages that draw rows should not draw them
     to two different rhythms. */
  .facts {
    margin: 1rem 0 0;
    padding: 0;
    max-width: 860px;
  }
  .facts > div {
    display: grid;
    grid-template-columns: 200px minmax(0, 62ch);
    column-gap: var(--space-5);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--ink-muted);
    padding-top: 0.2rem;
  }
  .facts dd {
    margin: 0;
    max-width: 62ch;
    font-size: var(--text-body-sm);
    line-height: 1.5;
  }
  .body {
    margin-top: 1rem;
  }
  .src {
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.9rem;
    font-size: var(--text-label);
  }
  .src a:not(.ast) {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .src .lesson {
    color: var(--ink-muted);
    font-size: var(--text-label-sm);
  }

  @media (max-width: 880px) {
    .facts > div {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-1);
    }
  }
</style>
