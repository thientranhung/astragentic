---
// /cau-truc · /en/structure — the four layers, then the parts of the harness worth
// keeping (build spec 4 §3 and §5), in Read mode (design spec 5 §2). The writer owns
// the prose in src/content/pages/<lang>/structure.md, split by `## runtime`,
// `## harness`, `## coordination`, `## project`, `## good-parts`.
import DocsLayout from '../../layouts/DocsLayout.astro';
import InteractiveDiagram from '../InteractiveDiagram.astro';
import Diagram from '../Diagram.astro';
import RoleKey from '../RoleKey.astro';
import Prose from '../Prose.astro';
import { getPage } from '../../lib/pages';
import { GOOD_PARTS, LAYERS } from '../../lib/anchors';
import { meta } from '../../lib/data';
import { roleHref } from '../../lib/roles';
import { termHref } from '../../lib/terms';
import { ROUTES, UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'structure');

const stackRoute = ROUTES.stack[lang];
const evidenceRoute = ROUTES.evidence[lang];
const structureMap: Record<string, string> = {
  runtime: '#runtime',
  harness: '#harness',
  coordination: '#coordination',
  project: '#project',
  runtime_claude: `${stackRoute}#claude-code`,
  runtime_codex: `${stackRoute}#codex`,
  runtime_opencode: `${stackRoute}#opencode`,
  roles: roleHref(lang, 'thomas'),
  skills: ROUTES.skills[lang],
  hooks: ROUTES.hooks[lang],
  ledger: evidenceRoute,
  tracker: termHref(lang, 'tracker'),
  herdr: `${stackRoute}#herdr`,
  worktrees: termHref(lang, 'worktree'),
};

const title = page.missing ? UI.structureTitle[lang] : page.title;
const heading = lang === 'vi' ? 'Astragentic gồm bốn lớp' : 'Astragentic is four layers';
---

<DocsLayout
  title={title}
  description={page.description}
  lang={lang}
  page="structure"
  eyebrow={UI.structureTitle[lang]}
  heading={page.missing ? heading : page.title}
>
  {page.intro && <Prose slot="lede" html={page.intro} class="lede" />}

  <div class="figure" data-toc-skip>
    <InteractiveDiagram slug="structure" lang={lang} hrefMap={structureMap} explore maxWidth={720} />
    <RoleKey lang={lang} />
    <p class="hint mono">{UI.diagramHint[lang]}</p>
  </div>

  {
    LAYERS.map((layer) => (
      <section class="read-section" id={layer.id}>
        <p class="parts-label mono" lang="en">{layer.parts}</p>
        <h2>{layer.title[lang]}</h2>
        {page.sections[layer.id] ? (
          <Prose html={page.sections[layer.id]} class="read-body body" />
        ) : (
          <p class="line">{layer.line[lang]}</p>
        )}
      </section>
    ))
  }

  <section class="read-section" id="good-parts">
    <h2>{lang === 'vi' ? 'Năm thứ mình sẽ giữ lại' : 'The five parts I would keep'}</h2>
    {page.sections['good-parts'] && <Prose html={page.sections['good-parts']} class="read-body body" />}
    <ul class="parts" data-toc-skip>
      {
        GOOD_PARTS.map((part) => (
          <li id={part.id} class:list={[part.id === 'cross-vendor-arm' && 'part--wide']}>
            <h3>{part.title[lang]}</h3>
            <p>{part.line[lang]}</p>
            {part.id === 'cross-vendor-arm' && (
              <div class="part-figure">
                <Diagram slug="cross-vendor-arm" lang={lang} frame={620} />
                <RoleKey lang={lang} />
              </div>
            )}
            {part.id === 'ledger' && (
              <p class="count">
                <span class="count-big mono">
                  {meta.cited} <span class="slash">/</span> {meta.total}
                </span>
                <span class="count-label mono">{UI.footerCited[lang]}</span>
                <a class="count-link mono" href={evidenceRoute}>{UI.openLedger[lang]}</a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</DocsLayout>

<style>
  .figure {
    margin-block: 1.5rem 0;
  }
  .hint {
    margin-top: 0.6rem;
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .parts-label {
    font-size: 10px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0 0 0.3rem;
  }
  .line {
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 64ch;
    margin: 0;
  }
  .body {
    margin-top: 0.5rem;
  }

  .parts {
    list-style: none;
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .parts li {
    margin: 0;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper-sunk);
  }
  .parts h3 {
    margin: 0 0 0.35rem;
    font-size: 16px;
  }
  .parts p {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-muted);
  }
  .part--wide {
    grid-column: 1 / -1;
  }
  .part-figure {
    margin-top: 0.75rem;
  }

  .count {
    display: block;
    margin-top: 0.75rem !important;
  }
  .count-big {
    display: block;
    font-size: 30px;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .count-big .slash {
    color: var(--rule);
  }
  .count-label {
    display: block;
    margin-top: 0.4rem;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .count-link {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 12px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 720px) {
    .parts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
