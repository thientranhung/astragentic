---
// /roles/<id> · /vi/role/<id> — one role, in Read mode (design spec 5 §2). The five
// roles diagram sits at the top with this role lit and the other four still clickable,
// and the key under it says which colour is which (§3).
import DocsLayout from '../../layouts/DocsLayout.astro';
import InteractiveDiagram from '../InteractiveDiagram.astro';
import RoleKey from '../RoleKey.astro';
import RoleBadge from '../RoleBadge.astro';
import DefectCard from '../DefectCard.astro';
import Prose from '../Prose.astro';
import { getRole, roleDefects, roleHref, roleContractHref, ROLE_IDS, ROLE_META, ROLE_SKILLS } from '../../lib/roles';
import { skillHref } from '../../lib/skills';
import type { RoleId } from '../../lib/roles';
import { ROUTES, UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
  id: RoleId;
}
const { lang, id } = Astro.props;

const role = await getRole(lang, id);
const meta = ROLE_META[id];
const defects = roleDefects(id);
const skills = ROLE_SKILLS[id];

const hrefMap = Object.fromEntries(
  ROLE_IDS.filter((other) => other !== id).map((other) => [other, roleHref(lang, other)]),
);
const alternate = { vi: roleHref('vi', id), en: roleHref('en', id) };
// The SVG tag reads `session: per ticket`; a writer may drop the prefix. Print one form.
const sessionTag = `session: ${role.sessionTag.replace(/^session:\s*/i, '')}`;
---

<DocsLayout
  title={role.title}
  description={role.tagline}
  lang={lang}
  alternate={alternate}
  eyebrow={UI.roleEyebrow[lang]}
  lede={role.tagline}
>
  <p class="stamp" data-toc-skip>
    <RoleBadge role={id} note={sessionTag} />
  </p>

  <div class="figure" data-toc-skip>
    <InteractiveDiagram slug="five-roles" lang={lang} hrefMap={hrefMap} activeId={id} maxWidth={860} />
    <RoleKey lang={lang} />
  </div>

  <section class="read-section" id="does">
    <h2>{UI.roleDoes[lang]}</h2>
    {
      role.sections['does'] ? (
        <Prose html={role.sections['does']} lead class="read-body" />
      ) : (
        <p class="gap mono">{UI.roleMissing[lang]}</p>
      )
    }
  </section>

  <section class="read-section" id="rights">
    <h2>{UI.roleRights[lang]}</h2>
    <div class="rights">
      <div class="col col--may">
        <p class="col-head mono">{UI.roleMay[lang]}</p>
        {role.sections['may'] ? <Prose html={role.sections['may']} /> : <p class="gap mono">—</p>}
      </div>
      <div class="col col--not">
        <p class="col-head mono">{UI.roleMayNot[lang]}</p>
        {
          role.sections['may-not'] ? (
            <Prose html={role.sections['may-not']} />
          ) : (
            <p class="gap mono">—</p>
          )
        }
      </div>
    </div>
  </section>

  <section class="read-section" id="defects">
    <h2>{UI.roleDefects[lang]}</h2>
    <p class="count mono" lang="en">
      {defects.length} entries · cited by {meta.cites.join(', ')}
    </p>
    {
      defects.length === 0 ? (
        <p class="gap mono">{UI.roleNoDefects[lang]}</p>
      ) : (
        <div class="defects">
          {defects.map((row) => (
            <DefectCard
              row={row}
              lang={lang}
              size="sm"
              compact={true}
            />
          ))}
        </div>
      )
    }
  </section>

  <section class="read-section" id="contract">
    <h2>{UI.roleContract[lang]}</h2>
    <div class="foot-links">
      <a class="foot-a mono" href={roleContractHref(id)} target="_blank" rel="noreferrer" lang="en">
        harness/.claude/agents/{id}.md ↗
      </a>
      {
        skills.length > 0 && (
          <div class="foot-skills">
            <p class="foot-label mono">{UI.roleSkills[lang]}</p>
            <ul class="skills">
              {skills.map((name) => (
                <li>
                  <a class="foot-a mono" href={skillHref(lang, name)} lang="en">
                    {name} →
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
</DocsLayout>

<style>
  .stamp {
    margin: -0.35rem 0 0;
  }
  .figure {
    margin-block: 1.5rem 0;
  }

  .gap {
    font-size: var(--text-mono);
    color: var(--ink-muted);
    margin: 0;
  }

  .rights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .col {
    padding: 1rem 1.15rem 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper-sunk);
  }
  .col :global(p),
  .col :global(li) {
    font-size: var(--text-body-sm);
  }
  .col--not {
    border-color: color-mix(in srgb, var(--defect) 35%, var(--rule));
  }
  .col-head {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin: 0 0 0.7rem;
  }
  .col--not .col-head {
    color: var(--defect);
  }

  .count {
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    margin: 0.2rem 0 0;
  }
  .defects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    align-items: baseline;
    margin-top: 0.75rem;
  }
  .foot-label {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin: 0 0 0.5rem;
  }
  .foot-a {
    font-size: var(--text-mono);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .foot-a:hover {
    border-bottom-color: var(--accent);
  }
  .skills {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .skills li {
    margin-bottom: 0.35rem;
  }

  @media (max-width: 620px) {
    .rights,
    .defects {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
