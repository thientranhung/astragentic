---
// /bang-chung · /en/evidence — the whole ledger, the orphan rows, and the commits that
// carry a `Ledger:` trailer. Read mode (design spec 5 §2). The confession opens the
// page, before any count.
import DocsLayout from '../../layouts/DocsLayout.astro';
import LedgerTable from '../LedgerTable.astro';
import QuoteBlock from '../QuoteBlock.astro';
import Prose from '../Prose.astro';
import { getPage, act } from '../../lib/pages';
import { commits, ledger, meta, ledgerTrailer } from '../../lib/data';
import { REPO, UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'evidence');

// Pass 2 closed the home page with these two acts. Pass 3 turned the home page into a
// landing page, so the prose moved here and the file stayed put (landing spec §2).
const home = await getPage(lang, 'home');

const QUOTE =
  'Every check in this package now proves the tooling is correct. Nothing in it proves the loop works.';
---

<DocsLayout
  title={page.title}
  description={page.description}
  lang={lang}
  page="evidence"
  eyebrow={`the ledger · ${meta.cited} / ${meta.total}`}
>
  <Prose slot="lede" html={page.intro} class="lede" />

  <div class="opener" data-toc-skip>
    <QuoteBlock source="RELEASE-NOTES.md:393" href={`${REPO}/blob/main/RELEASE-NOTES.md#L393`}>
      {QUOTE}
    </QuoteBlock>
  </div>

  {
    (home.sections['act-3'] || home.sections['act-4']) && (
      <section class="read-section" id="act-3">
        {act(home, 'act-3').headline && <h2>{act(home, 'act-3').headline}</h2>}
        <Prose html={home.sections['act-3'] ?? ''} lead class="read-body" />
        <div class="act-4" id="act-4">
          {act(home, 'act-4').headline && <h2>{act(home, 'act-4').headline}</h2>}
          <Prose html={home.sections['act-4'] ?? ''} class="read-body" />
        </div>
      </section>
    )
  }

  <section class="read-section" id="table">
    <h2>{lang === 'vi' ? 'Cả bảng' : 'The whole table'}</h2>
    <LedgerTable rows={ledger} lang={lang} scroll={false} />
  </section>

  <section class="read-section" id="orphan">
    <h2>
      {lang === 'vi'
        ? `${meta.orphan} dòng chưa buộc vào file nào`
        : `${meta.orphan} rows bound to nothing`}
    </h2>
    <Prose html={page.sections['orphan'] ?? ''} class="read-body" />
  </section>

  <section class="read-section" id="commits">
    <h2>{UI.commitsHeading[lang]}</h2>
    <ol class="commits">
      {
        commits.map((commit) => (
          <li class="commit">
            <a class="sha mono" href={`${REPO}/commit/${commit.sha}`} target="_blank" rel="noreferrer">
              {commit.sha.slice(0, 7)}
            </a>
            <span class="date mono">{commit.date}</span>
            <span class="subject" lang="en">{commit.subject}</span>
            <span class="trailer mono" lang="en">{ledgerTrailer(commit.ledger)}</span>
          </li>
        ))
      }
    </ol>
  </section>
</DocsLayout>

<style>
  .opener {
    margin-block: 1.25rem 0;
  }
  .act-4 {
    margin-top: 2rem;
  }

  .commits {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .commit {
    display: grid;
    grid-template-columns: 70px 90px minmax(0, 1fr);
    gap: 0.3rem 0.9rem;
    margin: 0;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule-faint);
  }
  .sha {
    font-size: var(--text-label);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    justify-self: start;
  }
  .date {
    font-size: var(--text-label);
    color: var(--ink-muted);
  }
  .subject {
    font-size: var(--text-body-sm);
    line-height: 1.35;
  }
  .trailer {
    grid-column: 3;
    font-size: var(--text-label);
    color: var(--ink-muted);
  }
  @media (max-width: 640px) {
    .commit {
      grid-template-columns: 70px minmax(0, 1fr);
    }
    .subject,
    .trailer {
      grid-column: 1 / -1;
    }
  }
</style>
