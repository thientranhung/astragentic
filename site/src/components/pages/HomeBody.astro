---
// The landing, v2. Five sections in the order the reader asks the questions (home v2
// spec): why this exists → what it does → how it runs → who it is for → how to start.
// Everything the page used to carry about layers, hooks, the skill catalog and the
// stack now lives only on its own page, still in the nav.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Diagram from '../Diagram.astro';
import InteractiveDiagram from '../InteractiveDiagram.astro';
import AdoptBlock from '../AdoptBlock.astro';
import { getPage } from '../../lib/pages';
import { getLanding } from '../../lib/landing';
import { ACTIVE, HAS_UNSET, SAMPLE, ORCHESTRATOR_FILE } from '../../lib/orchestrator';
import { failures } from '../../lib/data';
import { ROLE_META, roleHref, type RoleId } from '../../lib/roles';
import { termHref } from '../../lib/terms';
import { NAV, ROUTES, UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'home');
const copy = await getLanding(lang);

// The seven checkpoints, in order. Stage names are harness vocabulary and stay English
// in both locales. The lifecycle SVG names two of them differently; the map is the one
// place that translation lives.
const STAGES = ['claim', 'brief', 'build', 'code-review', 'simplify', 'arm', 'merge'];
const NODE_TO_STAGE: Record<string, string> = {
  claim: 'claim',
  brief: 'brief',
  implement: 'build',
  code_review: 'code-review',
  simplify: 'simplify',
  arm: 'arm',
  merge: 'merge',
};

const failuresRoute = ROUTES.failures[lang];
const adoptRoute = ROUTES.adopt[lang];
const whyRoute = ROUTES.why[lang];

// hero: the client-studio picture. Every box goes somewhere the client would look next.
const studioMap: Record<string, string> = {
  ...Object.fromEntries(Object.keys(ROLE_META).map((id) => [id, roleHref(lang, id)])),
  client: whyRoute,
  tracker: `${ROUTES.structure[lang]}#coordination`,
  herdr: `${ROUTES.stack[lang]}#herdr`,
};
const lifecycleMap = Object.fromEntries(
  Object.entries(NODE_TO_STAGE).map(([node, stage]) => [node, `${failuresRoute}#${stage}`]),
);

const perStage = STAGES.map((stage, i) => ({
  stage,
  number: String(i + 1).padStart(2, '0'),
  caption: copy.stages[stage] ?? '',
  hits: failures.filter((f) => f.stage === stage),
}));

// The three places the reader goes after installing, in nav order.
const adoptLinks = NAV.filter((item) => ['structure', 'roles', 'skills'].includes(item.key));

/** Card 5 has no drawing: the ladder is a table of literal strings read out of
 *  orchestrator.md, and a picture of a table is worse than the table. Four columns need
 *  their heads — "runtime" and "effort" are not readable off the values alone. */
const MODEL_CARD = 'models';
/** Card 4 quotes one row of the same file, because the sentence on it is about the
 *  declaration that file holds. */
const RUNTIME_CARD = 'runtime';
/** What a thumbnail's SVG actually occupies inside a card at 1200: the band divided
 *  three ways, less the gaps, the card's hairline and the frame's own padding. The
 *  label floor in src/lib/diagram.ts is measured against this number, so it is measured
 *  off the rendered page rather than guessed. */
const CARD_FRAME = 330;
---

<BaseLayout title={page.title} description={page.description} lang={lang} page="home">
  {/* ── 1 · Hero ─────────────────────────────────────────────────────────── */}
  <section class="screen screen--canvas hero-screen" id="hero">
    <div class="column-band hero">
      <div class="hero-copy">
        <p class="eyebrow">{copy.hero.eyebrow}</p>
        <h1>{copy.hero.headline}</h1>
        <p class="hero-sub">{copy.hero.sub}</p>
        <p class="cta">
          <a class="btn btn--primary" href="#lifecycle">{copy.hero.primary}</a>
          <a class="btn btn--ghost mono" href={adoptRoute}>{copy.hero.secondary} →</a>
        </p>
      </div>
      <div class="hero-art">
        {/* The client-studio picture, drawn from the owner's sketch: the tracker sits at
            the centre of the team and every edge passes through it. Numbers stay on
            /bang-chung; the hero carries no stat strip. */}
        <InteractiveDiagram slug="client-studio" lang={lang} hrefMap={studioMap} maxWidth={1120} />
      </div>
    </div>
  </section>

  {/* ── 2 · Why it exists ────────────────────────────────────────────────── */}
  <section class="screen screen--surface" id="why">
    <div class="column">
      <h2>{copy.why.headline}</h2>
    </div>
    <div class="column">
      <div class="two-col breakout">
        <p>{copy.why.p1}</p>
        <p>{copy.why.p2}</p>
      </div>
      <a class="more-link" href={whyRoute}>{copy.why.more}</a>
    </div>
  </section>

  {/* ── 3 · What it does ─────────────────────────────────────────────────── */}
  <section class="screen screen--canvas" id="features">
    <div class="column">
      <ul class="features band">
        {
          copy.features.map((feature) => (
            <li class="feature">
              <div class="thumb">
                {feature.id === MODEL_CARD ? (
                  <table class="models mono">
                    <thead>
                      <tr>
                        <th scope="col">{UI.colRole[lang]}</th>
                        <th scope="col" lang="en">{UI.colRuntime[lang]}</th>
                        <th scope="col" lang="en">{UI.colModel[lang]}</th>
                        <th scope="col" lang="en">{UI.colEffort[lang]}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {ACTIVE.map((row) => (
                        <tr data-role={row.role}>
                          <th scope="row">
                            <span class="dot" />
                            {ROLE_META[row.role as RoleId]?.label ?? row.role}
                          </th>
                          <td lang="en">{row.runtime}</td>
                          <td class="model" lang="en">{row.model}</td>
                          <td lang="en">{row.effort}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : feature.diagram ? (
                  <Diagram
                    slug={feature.diagram}
                    lang={lang}
                    crop={feature.crop}
                    frame={CARD_FRAME}
                    caption={false}
                  />
                ) : null}
              </div>
              <h3>{feature.title}</h3>
              <p class="feature-body">{feature.body}</p>
              {feature.id === RUNTIME_CARD && SAMPLE && (
                <p class="sample mono" lang="en">
                  <span class="sample-src">{ORCHESTRATOR_FILE}</span>
                  {[SAMPLE.role, SAMPLE.runtime, SAMPLE.model, SAMPLE.effort].join(' · ')}
                </p>
              )}
              {feature.id === MODEL_CARD && HAS_UNSET && (
                <p class="unset mono">— {UI.declareYourself[lang]}</p>
              )}
              {feature.href && (
                <a class="feature-link mono" href={feature.href}>{UI.featureMore[lang]}</a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── 4 · How it runs ──────────────────────────────────────────────────── */}
  <section class="screen screen--surface" id="lifecycle">
    <div class="column">
      <h2>{copy.sections.lifecycle.headline}</h2>
      <p class="sub">{copy.sections.lifecycle.sub}</p>
    </div>
    <div class="column">
      <InteractiveDiagram slug="ticket-lifecycle" lang={lang} hrefMap={lifecycleMap} class="band" />
      <ol class="steps band">
        {
          perStage.map(({ stage, number, caption, hits }) => (
            <li class:list={['step', hits.length > 0 && 'step--hit']}>
              <a class="step-head" href={`${failuresRoute}#${stage}`}>
                <span class="n mono">{number}</span>
                <span class="stage mono" lang="en">{stage}</span>
              </a>
              <p class="step-line">{caption}</p>
              {hits.length > 0 && (
                <p class="hits">
                  {hits.map((f) => (
                    <a class="ast" href={`${failuresRoute}#${f.id.toLowerCase()}`}>{f.id}</a>
                  ))}
                </p>
              )}
            </li>
          ))
        }
      </ol>
      <a class="more-link" href={failuresRoute}>{UI.readAll[lang]}</a>
    </div>
  </section>

  {/* ── 5 · Who it is for ────────────────────────────────────────────────── */}
  <section class="screen screen--canvas" id="fit">
    <div class="column">
      <h2>{copy.fit.headline}</h2>
      <p class="sub">{copy.fit.body}</p>
    </div>
    <div class="column">
      <div class="two-col fit breakout">
        <div>
          <p class="fit-head mono">{copy.fit.fitsLabel}</p>
          <ul class="fit-list">{copy.fit.fits.map((line) => <li>{line}</li>)}</ul>
        </div>
        <div>
          <p class="fit-head mono">{copy.fit.notYetLabel}</p>
          <ul class="fit-list fit-list--not">
            {copy.fit.notYet.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── 6 · How to start ─────────────────────────────────────────────────── */}
  <section class="screen screen--surface" id="requirements">
    <div class="column">
      <h2>{copy.adopt.reqHeadline ?? copy.adopt.reqTitle}</h2>
    </div>
    <div class="column">
      <AdoptBlock lang={lang} requirements={copy.adopt.requirements} reqTitle={copy.adopt.reqTitle} show="requirements" />
    </div>
  </section>

  <section class="screen screen--canvas" id="adopt">
    <div class="column">
      <h2>{copy.adopt.headline}</h2>
    </div>
    <div class="column">
      <AdoptBlock lang={lang} show="commands" />
      <ul class="onward">
        {
          adoptLinks.map((item) => (
            <li>
              <a class="mono" href={ROUTES[item.key][lang]}>{item.label[lang]}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── hero ── */
  .hero-screen {
    padding-block: 3rem 2.25rem;
  }
  /* Copy above, the client-studio picture below at full band width: the diagram has
     eight boxes and a right-hand column, and beside the copy its labels fell under 9px. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  /* The diagram below takes the full band, so the copy sits on the centre axis above it
     instead of hugging the left edge with an empty right half. */
  .hero-copy {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }
  .hero-copy .hero-sub {
    margin-inline: auto;
  }
  .hero-copy .cta {
    justify-content: center;
  }
  .hero-art {
    width: 100%;
  }
  /* Capped below the global h1: the hero headline is a whole sentence, and at the
     global size it takes five lines and outweighs the diagram beside it (PRD §5). */
  .hero h1 {
    font-size: var(--text-hero);
    line-height: 1.08;
    /* The writer sets the two-line break in the YAML; honour it. */
    white-space: pre-line;
    margin-bottom: 1rem;
  }
  .hero-sub {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0;
  }

  .screen h2 {
    font-size: var(--text-h2);
    text-wrap: balance;
  }
  .screen .sub {
    font-size: var(--text-body);
  }

  /* ── two columns of prose: why, and the fit lists ── */
  .two-col {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.5rem;
    margin-top: 1.75rem;
  }
  .two-col p {
    max-width: 62ch;
    margin: 0;
  }

  /* ── the six feature cards ── */
  .features {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    /* shorthand would reset margin-left and undo the band offset */
    margin-block: 0;
    padding: 0;
  }
  .feature {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 1.15rem 1.25rem 1.35rem;
    background: var(--surface);
    border: 1px solid var(--ink-10);
    border-radius: var(--radius-card);
  }
  /* One fixed frame for every thumbnail, whatever the crop's own ratio is: the drawing
     is fitted inside it, never cut, so the six cards start their copy on one line. The
     frame runs to the card's edges, because every pixel of width it gives back is a
     pixel the label floor can spend. */
  .thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 132px;
    margin: -1.15rem -1.25rem 1.1rem;
    padding-inline: 0.75rem;
    border-bottom: 1px solid var(--ink-10);
    overflow: hidden;
  }
  .thumb :global(.diagram) {
    margin: 0;
    width: 100%;
  }
  /* The pane's own frame would be a second border inside the card's. */
  .thumb :global(.diagram-svg) {
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
  }
  .feature h3 {
    font-size: var(--text-h3);
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }
  .feature-body {
    font-size: var(--text-body-sm);
    line-height: 1.5;
    color: var(--ink-muted);
    margin: 0 0 1rem;
  }
  /* One row of the file, quoted. Mono because every word in it is a literal string the
     reader would type into orchestrator.md. */
  .sample {
    font-size: var(--text-label-sm);
    color: var(--ink-70);
    margin: -0.4rem 0 1rem;
  }
  /* A path is a string the reader types, so it keeps its own case. Uppercasing it
     would make it a label instead of a literal. */
  .sample-src {
    display: block;
    font-size: var(--text-micro);
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
  }
  .unset {
    font-size: var(--text-label-sm);
    color: var(--ink-muted);
    margin: -0.4rem 0 1rem;
  }
  .feature-link {
    margin-top: auto;
    align-self: flex-start;
    font-size: var(--text-mono);
    letter-spacing: 0.04em;
    color: var(--pass);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .feature-link:hover {
    opacity: 0.75;
  }

  /* ── role → model, read off the orchestrator's Active assignments table ── */
  /* The frame runs to the card's edges for the drawings; the table is words, so it
     comes back to the same left edge as the title under it. */
  .models {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-label-sm);
    padding-inline: 0.5rem;
  }
  .models th,
  .models td {
    text-align: left;
    font-weight: 400;
    padding: 0.09rem 0;
    border-bottom: 1px solid var(--ink-05);
  }
  .models thead th {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    padding-bottom: 0.3rem;
    border-bottom-color: var(--rule);
  }
  .models tbody th {
    color: var(--ink);
    white-space: nowrap;
  }
  .models tbody td {
    color: var(--ink-muted);
    white-space: nowrap;
  }
  /* The model id is the longest string in the row and the one being compared down the
     column, so it takes the width and the others take what is left. */
  .models .model {
    color: var(--ink-88);
  }
  .models th:last-child,
  .models td:last-child {
    text-align: right;
  }
  .models tbody tr:last-child th,
  .models tbody tr:last-child td {
    border-bottom: 0;
  }
  .models .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-right: 0.4rem;
    vertical-align: middle;
    background: var(--role-thomas);
  }
  .models [data-role='shaper'] .dot {
    background: var(--role-shaper);
  }
  .models [data-role='builder'] .dot {
    background: var(--role-builder);
  }
  .models [data-role='rin'] .dot {
    background: var(--role-rin);
  }
  .models [data-role='qa'] .dot {
    background: var(--role-qa);
  }

  /* ── seven steps under the lifecycle diagram ── */
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.75rem;
    margin-block: 1.75rem 0;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .step {
    margin: 0;
    padding-top: 0.9rem;
  }
  .step-head {
    display: block;
    text-decoration: none;
  }
  .step .n {
    display: block;
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    color: var(--ink-62);
  }
  .step .stage {
    display: block;
    font-size: var(--text-label);
    letter-spacing: 0.02em;
    color: var(--ink-muted);
    margin-top: 0.1rem;
  }
  .step-head:hover .stage {
    color: var(--accent);
  }
  .step--hit .stage {
    color: var(--ink);
  }
  .step-line {
    font-size: var(--text-mono);
    line-height: 1.45;
    margin: 0.5rem 0 0;
    color: var(--ink-muted);
  }
  .hits {
    margin: 0.45rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .hits .ast {
    font-size: var(--text-label-sm);
  }

  /* ── fits / does not fit yet ── */
  .fit-head {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin: 0 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .fit-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fit-list li {
    position: relative;
    margin: 0 0 0.55rem;
    padding-left: 1.35rem;
    font-size: var(--text-body-sm);
    line-height: 1.45;
    color: var(--ink-88);
  }
  .fit-list li::before {
    content: '+';
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--ink-62);
  }
  /* Ledger Rust marks a measured limit, and "not yet" is one. It is not a button. */
  .fit-list--not li::before {
    content: '−';
    color: var(--defect);
  }

  /* ── the three pages to read after installing ── */
  .onward {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
  }
  .onward li {
    margin: 0;
  }
  .onward a {
    display: inline-flex;
    align-items: center;
    min-height: var(--row-h);
    font-size: var(--text-mono);
    letter-spacing: 0.06em;
    color: var(--pass);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .onward a:hover {
    opacity: 0.75;
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Under the copy now, so it takes the width it was capped at rather than half of
       it — a shrunk diagram is the one thing this page cannot afford. */
    .hero-art {
      max-width: 100%;
    }
    .features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: 1.5rem;
    }
  }
  @media (max-width: 560px) {
    .two-col,
    .features,
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
