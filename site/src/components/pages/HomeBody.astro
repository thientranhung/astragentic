---
import { hl } from '../../lib/markup';
// The landing, v2. Five sections in the order the reader asks the questions (home v2
// spec): why this exists → what it does → how it runs → who it is for → how to start.
// Everything the page used to carry about layers, hooks, the skill catalog and the
// stack now lives only on its own page, still in the nav.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Diagram from '../Diagram.astro';
import InteractiveDiagram from '../InteractiveDiagram.astro';
import AdoptBlock from '../AdoptBlock.astro';
import CodeFrame from '../CodeFrame.astro';
import Shot from '../Shot.astro';
import { getPage } from '../../lib/pages';
import { getLanding, panes } from '../../lib/landing';
import { ACTIVE, ACTIVE_TABLE, HAS_UNSET, SAMPLE, ORCHESTRATOR_FILE } from '../../lib/orchestrator';
import { failures, meta } from '../../lib/data';
import { ROLE_IDS, ROLE_META, roleHref, type RoleId } from '../../lib/roles';
import { termHref } from '../../lib/terms';
import { NAV, ROUTES, UI, type Lang } from '../../lib/site';
const rowFor = (id: string) => ACTIVE.find((r) => r.role.toLowerCase() === id.toLowerCase());

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'home');
const copy = await getLanding(lang);

// The seven checkpoints, in order. Stage names are harness vocabulary and stay English
// in both locales. The lifecycle SVG names two of them differently; the map is the one
// place that translation lives.
const STAGES = ['claim', 'brief', 'build', 'code-review', 'simplify', 'arm', 'merge'];
const NODE_TO_STAGE: Record<string, string> = {
  claim: 'claim',
  brief: 'brief',
  implement: 'build',
  code_review: 'code-review',
  simplify: 'simplify',
  arm: 'arm',
  merge: 'merge',
};

const failuresRoute = ROUTES.failures[lang];
const structureRoute = ROUTES.structure[lang];
const adoptRoute = ROUTES.adopt[lang];
const whyRoute = ROUTES.why[lang];

// The five explain sections (home explain spec §A-§E), keyed by their anchor id. The
// copy is the writer's; which drawing stands beside it is a layout decision and lives
// here. Static where the picture only names the parts, interactive where every box is
// a page the reader would open next.
const EX = copy.explain ?? {};
// §5 comms is hand-laid: each pane and each photograph sits under the paragraph it
// answers, so the template asks for its parts by index rather than looping.
const commsText = EX.comms?.paragraphs ?? [];
const commsPanes = panes(EX.comms?.commands);
/** Photographs of the running system, keyed by slug. Until the owner sends the files,
 *  a dashed frame carrying the caption stands in for each one (home order spec §3). */
const shots = copy.shots ?? {};
const roleMap = Object.fromEntries(ROLE_IDS.map((id) => [id, roleHref(lang, id)]));
const trackerMap: Record<string, string> = {
  thomas: roleHref(lang, 'thomas'),
  ...Object.fromEntries(
    ['frontier_query', 'board', 'tickets', 'assignee_field', 'blocking_edges'].map((id) => [
      id,
      `${structureRoute}#coordination`,
    ]),
  ),
};
/** What a figure beside the prose occupies inside the 1040 breakout, once the column
 *  gap is taken off. The label floor in src/lib/diagram.ts is measured against it. */
const SIDE_FRAME = 500;

// §4 team: the client-studio picture. Every box goes somewhere the client would look next.
const studioMap: Record<string, string> = {
  ...Object.fromEntries(Object.keys(ROLE_META).map((id) => [id, roleHref(lang, id)])),
  client: whyRoute,
  tracker: `${ROUTES.structure[lang]}#coordination`,
  herdr: `${ROUTES.stack[lang]}#herdr`,
};
const lifecycleMap = Object.fromEntries(
  Object.entries(NODE_TO_STAGE).map(([node, stage]) => [node, `${failuresRoute}#${stage}`]),
);

const perStage = STAGES.map((stage, i) => ({
  stage,
  number: String(i + 1).padStart(2, '0'),
  caption: copy.stages[stage] ?? '',
  hits: failures.filter((f) => f.stage === stage),
}));

// The three places the reader goes after installing, in nav order.
const adoptLinks = NAV.filter((item) => ['structure', 'roles', 'skills'].includes(item.key));

/** Card 5 has no drawing: the ladder is a table of literal strings read out of
 *  orchestrator.md, and a picture of a table is worse than the table. Four columns need
 *  their heads — "runtime" and "effort" are not readable off the values alone. */
const MODEL_CARD = 'models';
/** Card 4 quotes one row of the same file, because the sentence on it is about the
 *  declaration that file holds. */
const RUNTIME_CARD = 'runtime';
/** What a thumbnail's SVG actually occupies inside a card at 1200: the band divided
 *  three ways, less the gaps, the card's hairline and the frame's own padding. The
 *  label floor in src/lib/diagram.ts is measured against this number, so it is measured
 *  off the rendered page rather than guessed. */
const CARD_FRAME = 330;
---

<BaseLayout title={page.title} description={page.description} lang={lang} page="home">
  {/* ── 1 · Hero ─────────────────────────────────────────────────────────── */}
  <section class="screen screen--canvas hero-screen" id="hero">
    <div class="column-band hero">
      <div class="hero-copy">
        <p class="eyebrow" set:html={hl(String(copy.hero.eyebrow).replace("{{meta.version}}", meta.version))} />
        <h1 set:html={hl(copy.hero.headline)} />
        <p class="hero-sub" set:html={hl(copy.hero.sub)} />
        <p class="cta">
          {/* "See the team at work" now lands on §4, which is that picture. Before the
              reorder the only drawing was in the hero itself and this button had to
              reach the lifecycle to show anything running. */}
          <a class="btn btn--primary" href="#team">{copy.hero.primary}</a>
          <a class="btn btn--ghost mono" href={adoptRoute}>{copy.hero.secondary} →</a>
        </p>
      </div>
    </div>
  </section>

  {/* ── 2 · What an agent is (explain §A) ───────────────────────────────── */}
  {EX.agents && (
    <section class="screen screen--surface explain" id="agents">
      <div class="column">
        <p class="eyebrow">{EX.agents.eyebrow}</p>
        <h2>{EX.agents.headline}</h2>
      </div>
      <div class="column">
        {EX.agents.paragraphs?.map((line) => <p class="lede" set:html={hl(line)} />)}
        {/* No drawing here on purpose: five-roles is §C's figure and it needs the full
            band to clear the label floor, so a small copy of it beside this prose would
            render its names at six pixels. The three commands are the figure — one role,
            declared once, launched on three runtimes. */}
        {EX.agents.commands && (
          <div class="pane breakout">
            <CodeFrame
              lang={lang}
              lines={EX.agents.commands.lines}
              label={EX.agents.commands.label}
            />
          </div>
        )}
        {EX.agents.more && (
          <a class="more-link" href={EX.agents.more.href}>{EX.agents.more.label}</a>
        )}
      </div>
    </section>
  )}

  {/* ── 3 · The five roles (explain §C) ─────────────────────────────────── */}
  {EX.roles && (
    <section class="screen screen--canvas explain" id="roles">
      <div class="column">
        <p class="eyebrow">{EX.roles.eyebrow}</p>
        <h2>{EX.roles.headline}</h2>
      </div>
      <div class="column">
        {/* Five rows, not five columns: at a fifth of the band each card would be
            180px wide and every one of these paragraphs is three sentences. */}
        <ul class="roles breakout">
          {EX.roles.items?.map((item) => (
            <li>
              <a class="role-row has-dot" href={item.href} data-role={item.id}>
                <span class="role-name">
                  <span class="dot" />
                  <span class="rn" lang="en">{item.title}</span>
                  <span class="rt">{item.tag}</span>
                </span>
                <span class="role-copy">
                  <span class="role-session mono">{item.session}</span>
                  <span class="role-body" set:html={hl(item.body)} />
                  {rowFor(item.id) && (
                    <span class="role-model mono" lang="en">
                      {rowFor(item.id)!.runtime} · {rowFor(item.id)!.model} · effort {rowFor(item.id)!.effort}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
        {EX.roles.models && (
          <div class="role-models">
            <p class="eyebrow">{EX.roles.models.label}</p>
            <p class="lede" set:html={hl(EX.roles.models.intro)} />
            <p class="lede" set:html={hl(EX.roles.models.note)} />
            <CodeFrame lines={ACTIVE_TABLE} lang={lang} label={ORCHESTRATOR_FILE} class="role-models-table" />
          </div>
        )}
        <InteractiveDiagram slug="five-roles" lang={lang} hrefMap={roleMap} class="band" />
      </div>
    </section>
  )}

  {/* ── 4 · The whole team in one picture ────────────────────────────────── */}
  <section class="screen screen--surface" id="team">
    <div class="column">
      <h2>{copy.sections.team.headline}</h2>
      <p class="sub">{copy.sections.team.sub}</p>
    </div>
    <div class="column">
      {/* Drawn from the owner's sketch: the tracker sits at the centre of the team and
          every edge passes through it. It stands here rather than in the hero because
          the reader has just met the five roles and can now name every box in it. */}
      <InteractiveDiagram slug="client-studio" lang={lang} hrefMap={studioMap} class="band" />
    </div>
  </section>

  {/* ── 5 · How the agents talk (explain §B) ───────────────────────────── */}
  {EX.comms && (
    <section class="screen screen--canvas explain" id="comms">
      <div class="column">
        <p class="eyebrow">{EX.comms.eyebrow}</p>
        <h2>{EX.comms.headline}</h2>
      </div>
      <div class="column">
        {/* This section is laid out by hand rather than by the generic explain loop:
            each pane and each photograph answers the paragraph directly above it, and
            stacking all four paragraphs first would separate every one of them from
            its evidence. */}
        {commsText[0] && <p class="lede" set:html={hl(commsText[0])} />}
        {commsText[1] && <p class="lede" set:html={hl(commsText[1])} />}
        {commsPanes[0] && (
          <div class="pane breakout">
            <CodeFrame lang={lang} lines={commsPanes[0].lines} label={commsPanes[0].label} />
          </div>
        )}
        {shots.sendmessage && (
          <Shot lang={lang} caption={shots.sendmessage.caption} src={shots.sendmessage.src} class="breakout" />
        )}
        {commsText[2] && <p class="lede lede--after-figure" set:html={hl(commsText[2])} />}
        {commsPanes[1] && (
          <div class="pane breakout">
            <CodeFrame lang={lang} lines={commsPanes[1].lines} label={commsPanes[1].label} />
          </div>
        )}
        {shots.herdr && (
          <Shot lang={lang} caption={shots.herdr.caption} src={shots.herdr.src} class="breakout" />
        )}
        {commsText[3] && <p class="lede lede--after-figure" set:html={hl(commsText[3])} />}
        {EX.comms.more && (
          <a class="more-link" href={EX.comms.more.href}>{EX.comms.more.label}</a>
        )}
      </div>
    </section>
  )}

  {/* ── 6 · The tracker (explain §D) ────────────────────────────────────── */}
  {EX.tracker && (
    <section class="screen screen--surface explain" id="tracker">
      <div class="column">
        <p class="eyebrow">{EX.tracker.eyebrow}</p>
        <h2>{EX.tracker.headline}</h2>
      </div>
      <div class="column">
        {EX.tracker.paragraphs?.map((line) => <p class="lede" set:html={hl(line)} />)}
        {/* The five requirements are lifted out of tracker-contract.md and stay in the
            file's own words: a translated requirement is a different requirement. */}
        <div class="reqs breakout">
          <p class="reqs-label mono">{UI.verbatim[lang]}</p>
          <ol class="req-list">
            {EX.tracker.items?.map((item) => (
              <li class="mono" lang="en">{item.text}</li>
            ))}
          </ol>
        </div>
        <InteractiveDiagram slug="frontier-query" lang={lang} hrefMap={trackerMap} class="band" />
        {shots.tracker && (
          <Shot lang={lang} caption={shots.tracker.caption} src={shots.tracker.src} class="breakout" />
        )}
        {EX.tracker.more && (
          <a class="more-link" href={EX.tracker.more.href}>{EX.tracker.more.label}</a>
        )}
      </div>
    </section>
  )}

  {/* ── 7 · The method underneath (explain §E) ──────────────────────────── */}
  {EX.method && (
    <section class="screen screen--canvas explain" id="method">
      <div class="column">
        <p class="eyebrow" lang="en">{EX.method.eyebrow}</p>
        <h2>{EX.method.headline}</h2>
      </div>
      <div class="column">
        {EX.method.paragraphs?.map((line) => <p class="lede" set:html={hl(line)} />)}
        <dl class="method-map breakout">
          {EX.method.items?.map((item) => (
            <div class="mrow has-dot" data-role={item.id}>
              <dt>
                {item.id && <span class="dot" />}
                <span lang={item.id ? 'en' : undefined}>{item.title}</span>
              </dt>
              <dd class="mono" lang="en">{item.text}</dd>
            </div>
          ))}
        </dl>
        <Diagram slug="layer-map" lang={lang} svgMaxWidth={620} class="band" caption={false} />
        {EX.method.more && (
          <a class="more-link" href={EX.method.more.href}>{EX.method.more.label}</a>
        )}
      </div>
    </section>
  )}

  {/* ── 8 · Why it exists ───────────────────────────────────────────────── */}
  <section class="screen screen--surface" id="why">
    <div class="column">
      <h2>{copy.why.headline}</h2>
    </div>
    <div class="column">
      <div class="two-col breakout">
        <p set:html={hl(copy.why.p1)} />
        <p set:html={hl(copy.why.p2)} />
      </div>
      <a class="more-link" href={whyRoute}>{copy.why.more}</a>
    </div>
  </section>

  {/* ── 9 · What it does ────────────────────────────────────────────────── */}
  <section class="screen screen--canvas" id="features">
    <div class="column">
      <ul class="features band">
        {
          copy.features.map((feature) => (
            <li class="feature">
              <div class="thumb">
                {feature.id === MODEL_CARD ? (
                  <table class="models mono">
                    <thead>
                      <tr>
                        <th scope="col">{UI.colRole[lang]}</th>
                        <th scope="col" lang="en">{UI.colRuntime[lang]}</th>
                        <th scope="col" lang="en">{UI.colModel[lang]}</th>
                        <th scope="col" lang="en">{UI.colEffort[lang]}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {ACTIVE.map((row) => (
                        <tr data-role={row.role}>
                          <th scope="row">
                            <span class="dot" />
                            {ROLE_META[row.role as RoleId]?.label ?? row.role}
                          </th>
                          <td lang="en">{row.runtime}</td>
                          <td class="model" lang="en">{row.model}</td>
                          <td lang="en">{row.effort}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ) : feature.diagram ? (
                  <Diagram
                    slug={feature.diagram}
                    lang={lang}
                    crop={feature.crop}
                    frame={CARD_FRAME}
                    caption={false}
                  />
                ) : null}
              </div>
              <h3>{feature.title}</h3>
              <p class="feature-body" set:html={hl(feature.body)} />
              {feature.id === RUNTIME_CARD && SAMPLE && (
                <p class="sample mono" lang="en">
                  <span class="sample-src">{ORCHESTRATOR_FILE}</span>
                  {[SAMPLE.role, SAMPLE.runtime, SAMPLE.model, SAMPLE.effort].join(' · ')}
                </p>
              )}
              {feature.id === MODEL_CARD && HAS_UNSET && (
                <p class="unset mono">— {UI.declareYourself[lang]}</p>
              )}
              {feature.href && (
                <a class="feature-link mono" href={feature.href}>{UI.featureMore[lang]}</a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── 10 · How it runs ────────────────────────────────────────────────── */}
  <section class="screen screen--surface" id="lifecycle">
    <div class="column">
      <h2>{copy.sections.lifecycle.headline}</h2>
      <p class="sub">{copy.sections.lifecycle.sub}</p>
    </div>
    <div class="column">
      <InteractiveDiagram slug="ticket-lifecycle" lang={lang} hrefMap={lifecycleMap} class="band" />
      <ol class="steps band">
        {
          perStage.map(({ stage, number, caption, hits }) => (
            <li class:list={['step', hits.length > 0 && 'step--hit']}>
              <a class="step-head" href={`${failuresRoute}#${stage}`}>
                <span class="n mono">{number}</span>
                <span class="stage mono" lang="en">{stage}</span>
              </a>
              <p class="step-line">{caption}</p>
              {hits.length > 0 && (
                <p class="hits">
                  {hits.map((f) => (
                    <a class="ast" href={`${failuresRoute}#${f.id.toLowerCase()}`}>{f.id}</a>
                  ))}
                </p>
              )}
            </li>
          ))
        }
      </ol>
      <a class="more-link" href={failuresRoute}>{UI.readAll[lang]}</a>
    </div>
  </section>

  {/* ── 11 · Who it is for ──────────────────────────────────────────────── */}
  <section class="screen screen--canvas" id="fit">
    <div class="column">
      <h2>{copy.fit.headline}</h2>
      <p class="sub" set:html={hl(copy.fit.body)} />
    </div>
    <div class="column">
      <div class="two-col fit breakout">
        <div>
          <p class="fit-head mono">{copy.fit.fitsLabel}</p>
          <ul class="fit-list">{copy.fit.fits.map((line) => <li>{line}</li>)}</ul>
        </div>
        <div>
          <p class="fit-head mono">{copy.fit.notYetLabel}</p>
          <ul class="fit-list fit-list--not">
            {copy.fit.notYet.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── 12 · How to start ───────────────────────────────────────────────── */}
  <section class="screen screen--surface" id="requirements">
    <div class="column">
      <h2>{copy.adopt.reqHeadline ?? copy.adopt.reqTitle}</h2>
    </div>
    <div class="column">
      <AdoptBlock lang={lang} requirements={copy.adopt.requirements} reqTitle={copy.adopt.reqTitle} show="requirements" />
    </div>
  </section>

  <section class="screen screen--canvas" id="adopt">
    <div class="column">
      <h2>{copy.adopt.headline}</h2>
    </div>
    <div class="column">
      <AdoptBlock lang={lang} show="commands" />
      <ul class="onward">
        {
          adoptLinks.map((item) => (
            <li>
              <a class="mono" href={ROUTES[item.key][lang]}>{item.label[lang]}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.brand) {
    font-weight: 600;
    color: var(--ink);
  }
  /* Owner's positioning phrases, marked **…** in the copy: brand red at text weight. */
  .hero-copy :global(.hl) {
    color: var(--brand-primary-hover);
    font-weight: inherit;
  }
  .eyebrow :global(.hl) {
    color: var(--brand-primary-hover);
    font-weight: 600;
  }
  /* ── hero ──────────────────────────────────────────────────────────────────
     Words only. The client-studio picture used to stand here and now opens §4,
     where the reader has already met the five roles it names — so the first screen
     gets the vertical room the drawing was taking instead. */
  .hero-screen {
    padding-block: 5rem 4.5rem;
  }
  .hero-copy {
    max-width: 780px;
    margin-inline: auto;
    text-align: center;
  }
  .hero-copy .hero-sub {
    margin-inline: auto;
  }
  .hero-copy .cta {
    justify-content: center;
  }
  /* Capped below the global h1: the hero headline is a whole sentence, and at the
     global size it takes five lines and outweighs the diagram beside it (PRD §5). */
  .hero h1 {
    font-size: var(--text-hero);
    line-height: 1.08;
    /* The writer sets the two-line break in the YAML; honour it. */
    white-space: pre-line;
    margin-bottom: 1rem;
  }
  .hero-sub {
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--ink-muted);
    max-width: 62ch;
    margin-bottom: 1.5rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0;
  }

  /* ── the five explain sections (home explain spec §A-§E) ─────────────────
     Every figure here runs the full band and every pane the full breakout. A drawing
     set beside the prose at half the band renders archify's 11-unit titles at under
     six pixels, and the growth cap in src/lib/diagram.ts cannot lift them to the 13px
     floor — so these sections stack instead of splitting. */
  .explain .lede {
    max-width: 62ch;
    margin: 0 0 1.1rem;
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }
  .explain .lede:first-child {
    margin-top: 1.75rem;
  }
  /* Prose resuming after a pane or a photograph: without this the paragraph sits
     0px under the caption above it and reads as part of the figure. */
  .explain .lede--after-figure {
    margin-top: 2rem;
  }
  .pane {
    margin-top: 2rem;
  }
  /* A boxed code span split across a line break reads as a rendering fault; these are
     all short enough to move to the next line whole. */
  .explain .lede :global(code) {
    white-space: nowrap;
  }

  /* One dot vocabulary for both lists on this page: the role hue is 8px of colour and
     nothing else wears it (design system, The Dot-Size Rule). */
  .has-dot .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 0.5rem;
    vertical-align: middle;
    background: var(--ink-35);
  }
  .has-dot[data-role='thomas'] .dot {
    background: var(--role-thomas);
  }
  .has-dot[data-role='shaper'] .dot {
    background: var(--role-shaper);
  }
  .has-dot[data-role='builder'] .dot {
    background: var(--role-builder);
  }
  .has-dot[data-role='rin'] .dot {
    background: var(--role-rin);
  }
  .has-dot[data-role='qa'] .dot {
    background: var(--role-qa);
  }

  /* ── five roles, one row each ── */
  .roles {
    list-style: none;
    /* shorthand would reset margin-left and undo the breakout offset */
    margin-block: 1.75rem 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .roles li {
    margin: 0;
    border-bottom: 1px solid var(--rule-faint);
  }
  /* The whole row is the link. At rest nothing is coloured; the arrow takes the red on
     hover, so five role names do not put five reds down the page. */
  .role-row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    min-height: var(--row-h);
    padding-block: 0.9rem;
    color: inherit;
    text-decoration: none;
  }
  /* The affordance sits on the name, where the eye already is: the site's own link
     vocabulary, an ink hairline that goes brand when the row is under the cursor. */
  .rn {
    font-size: var(--text-ui);
    font-weight: 700;
    color: var(--ink);
    border-bottom: 1px solid var(--ink-22);
    padding-bottom: 2px;
    transition: border-color var(--motion-hover) var(--ease-out);
  }
  .role-row:hover .rn,
  .role-row:focus-visible .rn {
    border-bottom-color: var(--pass);
  }
  .rt {
    display: block;
