---
// /skills · /en/skills — the catalog, filed by the moment you reach for one (PRD §5,
// aihero-style). Design spec 5 §2: a table, not a page of cards. One row per skill at
// about 44px, the whole row a link, the group said in colour on the right.
import DocsLayout from '../../layouts/DocsLayout.astro';
import GroupBadge from '../GroupBadge.astro';
import { getSkillGroups } from '../../lib/skills';
import { UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const groups = await getSkillGroups(lang);
const count = groups.reduce((n, group) => n + group.skills.length, 0);

const title = UI.skillsTitle[lang];
const lede =
  lang === 'vi'
    ? 'Skill là quy trình viết sẵn cho một lúc cụ thể. Danh sách dưới đây xếp theo lúc anh em cần đến chúng, không theo cái chúng làm bằng gì.'
    : 'A skill is a written-down procedure for one moment. The list below is filed by when you need one, not by what it is made of.';
---

<DocsLayout
  title={title}
  description={lede}
  lang={lang}
  page="skills"
  eyebrow={`${count} ${UI.skillsCount[lang]}`}
  lede={lede}
>
  {
    groups.map((group) => (
      <section class="group" id={group.id} data-group={group.id}>
        <h2 class="group-head">
          <span class="dot" />
          <span>{group.title}</span>
        </h2>
        <p class="group-line">{group.line}</p>
        <ul class="rows">
          {group.skills.map((skill) => (
            <li data-group={group.id}>
              <a href={skill.href}>
                <span class="name mono" lang="en">
                  {skill.name}
                </span>
                <span class="line">{skill.line}</span>
                <GroupBadge group={group.id} lang={lang} short class="row-badge" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</DocsLayout>

<style>
  .group + .group {
    margin-top: 1.5rem;
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 17px;
    margin-bottom: 0.15rem;
  }
  .group-line {
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-muted);
    margin: 0 0 0.4rem;
    max-width: 62ch;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .rows li {
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }
  /* The whole row is the target, not the name inside it. */
  .rows a {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr) 6.75rem;
    gap: 0.9rem;
    align-items: center;
    min-height: 44px;
    padding: 0.35rem 0.6rem;
    margin-inline: -0.6rem;
    border-radius: 2px;
    text-decoration: none;
  }
  .rows a:hover {
    background: var(--tone-soft);
  }
  .rows a:hover .name {
    color: var(--tone-ink);
  }
  .name {
    font-size: 13px;
    letter-spacing: 0.005em;
    color: var(--ink);
  }
  .line {
    font-size: 14px;
    line-height: 1.3;
    color: var(--ink-muted);
  }

  @media (max-width: 700px) {
    .rows a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.15rem 0.75rem;
      align-items: baseline;
    }
    .line {
      grid-column: 1 / -1;
    }
  }
</style>
