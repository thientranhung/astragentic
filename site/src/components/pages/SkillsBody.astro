---
// /skills · /vi/skills — the catalog, filed by the moment you reach for one (PRD §5,
// aihero-style). Design spec 5 §2: a table, not a page of cards. One row per skill at
// about 44px, the whole row a link, the group said in colour on the right.
import DocsLayout from '../../layouts/DocsLayout.astro';
import GroupBadge from '../GroupBadge.astro';
import { getSkillGroups } from '../../lib/skills';
import { UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const groups = await getSkillGroups(lang);
const count = groups.reduce((n, group) => n + group.skills.length, 0);

const title = UI.skillsTitle[lang];
const lede =
  lang === 'vi'
    ? 'Skill là quy trình viết sẵn cho một tình huống cụ thể. Danh sách dưới đây xếp theo lúc bạn cần dùng, không theo thành phần cấu tạo.'
    : 'A skill is a written procedure for one situation. The list below is grouped by when you need one, not by what it is made of.';
---

<DocsLayout
  title={title}
  description={lede}
  lang={lang}
  page="skills"
  eyebrow={`${count} ${UI.skillsCount[lang]}`}
  lede={lede}
>
  {
    groups.map((group) => (
      <section class="group" id={group.id} data-group={group.id}>
        <h2 class="group-head">
          <span class="dot" />
          <span>{group.title}</span>
        </h2>
        <p class="group-line">{group.line}</p>
        <ul class="rows">
          {group.skills.map((skill) => (
            <li data-group={group.id}>
              <a href={skill.href}>
                <span class="name mono" lang="en">
                  {skill.name}
                </span>
                <span class="line">{skill.line}</span>
                <GroupBadge group={group.id} lang={lang} short class="row-badge" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</DocsLayout>

<style>
  /* The vertical rhythm is measured, not eyeballed: 32px between groups, 4px from a
     group heading to its line, 12px from that line to the first row, 12px above and
     below every row. The old values were four different fractions of a rem and the
     table read as if each group had been spaced by hand. */
  .group + .group {
    margin-top: var(--space-6);
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-body);
    margin-bottom: var(--space-1);
  }
  .group-line {
    font-size: var(--text-ui);
    line-height: var(--leading-mono);
    color: var(--ink-muted);
    margin: 0 0 var(--space-3);
    max-width: 62ch;
  }
  /* 200 + 24 + 62ch + 24 + 132 lands just under 860, so the table stops there instead
     of stretching to the card. The badge is right-aligned inside its own column rather
     than at the far edge of the page, which is what kept it drifting away from the
     description it belongs to. */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 860px;
    border-top: 1px solid var(--rule);
  }
  .rows li {
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }
  /* The whole row is the target, not the name inside it. */
  .rows a {
    display: grid;
    grid-template-columns: 200px minmax(0, 62ch) 132px;
    column-gap: var(--space-5);
    align-items: center;
    min-height: var(--row-h);
    padding: var(--space-3) 0.6rem;
    margin-inline: -0.6rem;
    border-radius: var(--radius-badge);
    text-decoration: none;
  }
  .rows a:hover {
    background: var(--surface-2);
  }
  .rows a:hover .name {
    color: var(--accent);
  }
  .row-badge {
    justify-self: end;
  }
  .name {
    font-size: var(--text-mono);
    letter-spacing: 0.005em;
    color: var(--ink);
  }
  .line {
    max-width: 62ch;
    font-size: var(--text-ui);
    line-height: 1.3;
    color: var(--ink-muted);
  }

  /* Below the three-column width the name and the badge share the first line and the
     description takes the second. The 12px row padding stays: it is the rhythm, not a
     desktop luxury. */
  @media (max-width: 880px) {
    .rows a {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-3);
      row-gap: var(--space-1);
      align-items: baseline;
    }
    .line {
      grid-column: 1 / -1;
    }
  }
</style>
