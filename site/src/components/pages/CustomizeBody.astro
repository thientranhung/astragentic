---
// /customize · /vi/tuy-bien — install it, then change it.
// Read mode (design spec 5 §2).
import DocsLayout from '../../layouts/DocsLayout.astro';
import Prose from '../Prose.astro';
import { getPage } from '../../lib/pages';
import { meta } from '../../lib/data';
import { UI, type Lang } from '../../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'customize');
---

<DocsLayout
  harness={page.harness}
  title={page.title}
  description={page.description}
  lang={lang}
  page="customize"
  eyebrow={`${UI.customizeEyebrow[lang]} · v${meta.version}`}
>
  <Prose slot="lede" html={page.intro} class="lede" />

  <section class="read-section" id="install">
    <h2>{UI.quickstart[lang]}</h2>
    {page.sections['install'] && <Prose html={page.sections['install']} class="read-body read-body--sections" />}
  </section>

  {
    (['customize', 'agent-customize', 'self-repair'] as const).map((id) => (
      <section class="read-section" id={id}>
        <h2>{UI.customizeHeads[id][lang]}</h2>
        {page.sections[id] && <Prose html={page.sections[id]} class="read-body read-body--sections" />}
      </section>
    ))
  }
</DocsLayout>
