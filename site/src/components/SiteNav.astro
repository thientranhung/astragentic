---
// The Read-mode sidebar (design spec 5 §2). One component, one tree, generated in
// src/lib/nav-tree.ts — so the sidebar cannot list a skill the site does not have, or
// miss one it does.
//
// The section holding the current page opens on arrival; every other section is a
// closed <details>. On a phone the whole rail collapses into one "Mục lục" details at
// the top of the page and the right-hand TOC goes away entirely.
import { getNavTree, sectionHoldsPath, samePath } from '../lib/nav-tree';
import { UI, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  /** Pathname of the page being read, for the active mark. */
  path: string;
}
const { lang, path } = Astro.props;
const tree = await getNavTree(lang);
---

<details class="rail-shell" open>
  <summary class="rail-summary mono">{UI.contents[lang]}</summary>
  <nav class="rail" aria-label={UI.contents[lang]}>
    <ul class="sections">
      {
        tree.map((section) => {
          const holds = sectionHoldsPath(section, path);
          const leaf = !section.items && !section.groups;
          return (
            <li class="section">
              {leaf ? (
                <a
                  href={section.href}
                  class:list={['top', samePath(section.href!, path) && 'on']}
                >
                  {section.label}
                </a>
              ) : (
                <details open={holds}>
                  <summary class="top top--toggle">
                    <span>{section.label}</span>
                    <svg class="chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                      <path
                        d="M4.5 2.5 8 6l-3.5 3.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </summary>
                  <div class="under">
                    {section.href && (
                      <a
                        href={section.href}
                        class:list={['leaf', 'leaf--all', samePath(section.href, path) && 'on']}
                      >
                        {UI.overview[lang]}
                      </a>
                    )}
                    {section.items && (
                      <ul class="leaves">
                        {section.items.map((item) => (
                          <li>
                            <a
                              href={item.href}
                              data-anchor={item.anchor}
                              data-anchor-page={item.anchor ? item.href.split('#')[0] : undefined}
                              data-role={item.role}
                              class:list={[
                                'leaf',
                                item.role && 'leaf--dot',
                                !item.anchor && samePath(item.href, path) && 'on',
                              ]}
                            >
                              {item.role && <span class="dot" />}
                              <span class="leaf-text">{item.label}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                    {section.groups?.map((group) => (
                      <div class="skill-group" data-group={group.id}>
                        <p class="group-head">
                          <span class="dot" />
                          <span>{group.label}</span>
                        </p>
                        <ul class="leaves">
                          {group.items.map((item) => (
                            <li>
                              <a
                                href={item.href}
                                data-group={item.group}
                                class:list={['leaf', 'leaf--mono', samePath(item.href, path) && 'on']}
                                lang="en"
                              >
                                {item.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              )}
            </li>
          );
        })
      }
    </ul>
  </nav>
</details>

<script is:inline>
  /* The rail is one <details>: open on a wide screen, where it is the sidebar and its
     summary is not drawn, and collapsed on a phone, where forty links ahead of the
     first paragraph is the whole page. It ships open so that with scripting off a wide
     reader still has navigation; this closes it once we know the screen is narrow. */
  (function () {
    var shell = document.querySelector('.rail-shell');
    if (!shell) return;
    var wide = window.matchMedia('(min-width: 901px)');
    var sync = function () {
      shell.open = wide.matches;
    };
    sync();
    wide.addEventListener('change', sync);
  })();
</script>

<style>
  .rail-shell {
    font-family: var(--font-mono);
  }
  .rail-summary {
    display: none;
  }

  .sections,
  .leaves {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .section {
    margin: 0 0 0.1rem;
  }
  .leaves li {
    margin: 0;
  }

  /* ── top level ── */
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
    padding: 0.42rem 0.6rem;
    border-radius: var(--radius-badge);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
  }
  .top--toggle {
    list-style: none;
  }
  .top--toggle::-webkit-details-marker {
    display: none;
  }
  .top:hover {
    background: var(--surface-2);
  }
  a.top.on {
    background: var(--brand-primary-soft);
    color: var(--brand-primary-hover);
    box-shadow: inset 2px 0 0 var(--brand-primary);
  }
  .chev {
    flex: none;
    color: var(--ink-muted);
    transition: transform var(--motion-drawer) var(--ease-out);
  }
  details[open] > .top--toggle .chev {
    transform: rotate(90deg);
  }

  .under {
    padding: 0.15rem 0 0.55rem 0.6rem;
    margin-left: 0.35rem;
    border-left: 1px solid var(--rule);
  }

  /* ── leaves ── */
  .leaf {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.34rem 0.55rem;
    border-radius: var(--radius-badge);
    font-family: var(--font-sans);
    font-size: var(--text-ui);
    line-height: 1.35;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .leaf--mono {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.005em;
  }
  .leaf--all {
    font-family: var(--font-mono);
    font-size: var(--text-label-sm);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .leaf-text {
    display: block;
    min-width: 0;
  }
  .leaf:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  /* The 2px bar is a navigation indicator, not card decoration: it says "you are
     here", which is the one thing a 40-item tree has to say at a glance. */
  .leaf.on {
    background: var(--brand-primary-soft);
    color: var(--brand-primary-hover);
    box-shadow: inset 2px 0 0 var(--brand-primary);
  }
  /* A role or group leaf used to carry its own hue in the 2px bar. Pass 7 gave the
     current row a soft brand ground, and a pink row with a teal bar is two claims on
     one line: the ground already says "you are here". The hue stays on the dot beside
     the label, which is where the reader looks for "which role is this" anyway. */
  .leaf.on[data-role],
  .leaf.on[data-group] {
    color: var(--brand-primary-hover);
  }

  .skill-group + .skill-group {
    margin-top: 0.6rem;
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.35rem 0 0.15rem;
    padding-inline: 0.55rem;
    font-size: var(--text-micro);
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* The rail's rows are the width of the card, so they are easy to hit sideways and
     thin vertically — 26px for a leaf. A finger needs the other axis too. */
  @media (pointer: coarse) {
    .top {
      min-height: 40px;
    }
    .leaf {
      min-height: 38px;
    }
  }

  @media (max-width: 900px) {
    .rail-shell {
      border: 1px solid var(--ink-10);
      border-radius: var(--radius-card);
      background: var(--surface);
      margin-bottom: 1.5rem;
    }
    .rail-summary {
      display: block;
      padding: 0.7rem 0.9rem;
      font-size: var(--text-label-sm);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted);
      cursor: pointer;
    }
    .rail {
      padding: 0 0.6rem 0.7rem;
    }
  }
</style>
