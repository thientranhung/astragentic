---
// Three tracker boards hung on a gallery wall: white frame, mat, a placard under each
// naming the adapter that drives it. One hangs large, two small beside it, and they
// take turns in the large spot (see the script). A click on the large one opens it
// at full width in a native <dialog>; no animation library anywhere.
import { UI, type Lang } from '../lib/site';

export interface WallCard {
  name: string;
  adapter: string;
  src: string;
  note?: string;
}

interface Props {
  lang: Lang;
  cards: WallCard[];
  caption: string;
  class?: string;
}
const { lang, cards, caption, class: extra = '' } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
---

<figure class:list={['wall', 'is-0', extra]} data-count={cards.length}>
  <div class="wall-row">
    {cards.map((c, i) => (
      <div class="hang" data-i={i}>
        <button class="frame" type="button" data-open={`${uid}-${i}`} data-i={i} aria-label={`${c.name} · ${UI.wallOpen[lang]}`}>
          <span class="mat"><img src={c.src} alt={`${c.name}${c.note ? ` · ${c.note}` : ''}`} loading="lazy" decoding="async" /></span>
        </button>
        <p class="placard mono">
          <b>{c.adapter}</b>
          <span>{c.name}{c.note && ` · ${c.note}`}</span>
        </p>
        <dialog class="light" id={`${uid}-${i}`}>
          <form method="dialog" class="light-bar">
            <span class="mono"><b>{c.adapter}</b> · {c.name}{c.note && ` · ${c.note}`}</span>
            <button class="mono" type="submit">{UI.close[lang]}</button>
          </form>
          {/* same file as the framed one, so it comes from cache; no lazy here, a
              lazy image inside a closed dialog can stay blank for a beat */}
          <img src={c.src} alt={`${c.name}${c.note ? ` · ${c.note}` : ''}`} decoding="async" />
        </dialog>
      </div>
    ))}
  </div>
  <figcaption class="wall-cap">{caption}</figcaption>
</figure>

<script>
  // Which board hangs large is the figure's `is-N` class. Swapping is a class change;
  // the motion is FLIP: measure, switch, then play each frame from its old box to
  // its new one with the Web Animations API. The large frame opens the lightbox; a
  // small one takes the large spot. Every 6 s the next small one comes forward,
  // unless the wall is off screen, its lightbox is open, or motion is reduced.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.wall').forEach((wall) => {
    const count = Number(wall.dataset.count || 0);
    const hangs = Array.from(wall.querySelectorAll<HTMLElement>('.hang'));
    let large = 0;
    let timer: number | undefined;
    const rects = () => hangs.map((h) => h.getBoundingClientRect());
    const setLarge = (n: number) => {
      const before = rects();
      large = (n + count) % count;
      wall.className = wall.className.replace(/\bis-\d+\b/, `is-${large}`);
      if (reduce.matches) return;
      const after = rects();
      hangs.forEach((h, k) => {
        const a = before[k], b = after[k];
        const dx = a.left - b.left, dy = a.top - b.top, sx = a.width / b.width, sy = a.height / b.height;
        if (!dx && !dy && sx === 1 && sy === 1) return;
        h.animate(
          [{ transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`, transformOrigin: 'top left' }, { transform: 'none', transformOrigin: 'top left' }],
          { duration: 650, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
      });
    };
    const next = () => setLarge(large + 1);
    const stop = () => { if (timer) { window.clearInterval(timer); timer = undefined; } };
    const start = () => { if (!timer && !reduce.matches) timer = window.setInterval(next, 6000); };
    wall.querySelectorAll<HTMLButtonElement>('.frame').forEach((b) => {
      b.addEventListener('click', () => {
        const i = Number(b.dataset.i);
        if (i === large) {
          stop();
          (document.getElementById(b.dataset.open!) as HTMLDialogElement | null)?.showModal();
        } else {
          setLarge(i);
          stop(); start();
        }
      });
    });
    // no hover pause: a pointer parked over the wall would freeze it for good; the
    // wall pauses only while its lightbox is open
    wall.querySelectorAll<HTMLDialogElement>('dialog.light').forEach((d) => {
      d.addEventListener('close', start);
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start() : stop()))).observe(wall);
    } else start();
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.light').forEach((d) => {
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>

<style>
  .wall {
    margin-block: 1.75rem 0;
    padding: 0;
  }
  /* The wall: a warm dark grey band the frames sit on, like the room in the reference. */
  /* One large frame for the real board, two smaller ones stacked beside it, the way
     a wall mixes sizes; the large one is wide enough to read the ticket titles. */
  .wall-row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: clamp(1rem, 2vw, 1.6rem);
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.25rem, 3vw, 2.5rem);
    background: color-mix(in srgb, var(--ink) 74%, var(--surface));
    border-radius: var(--radius-card);
  }
  .hang {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }
  /* the large one takes column 1 across both rows; the others fill column 2 in order */
  .wall.is-0 .hang[data-i='0'], .wall.is-1 .hang[data-i='1'], .wall.is-2 .hang[data-i='2'] {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: center;
  }
  .hang { grid-column: 2; }
  .frame[data-i] { cursor: pointer; }
  .wall.is-0 .frame[data-i='0'], .wall.is-1 .frame[data-i='1'], .wall.is-2 .frame[data-i='2'] { cursor: zoom-in; }
  .frame {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--surface);
    /* frame moulding: white, with the room's shadow on the wall */
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 18px 34px -14px rgba(0, 0, 0, 0.55),
      0 4px 10px rgba(0, 0, 0, 0.25);
    cursor: zoom-in;
    transition: transform var(--motion-fast, 160ms) ease;
  }
  .frame:hover,
  .frame:focus-visible {
    transform: translateY(-2px);
    outline: 2px solid var(--brand-primary);
    outline-offset: 3px;
  }
  .mat {
    display: block;
    padding: clamp(0.4rem, 0.9vw, 0.7rem);
    border: 1px solid var(--ink-10);
    margin: clamp(0.25rem, 0.5vw, 0.4rem);
  }
  .mat img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    border: 1px solid var(--ink-10);
  }
  .placard {
    margin: 0;
    background: var(--surface);
    border-radius: var(--radius-badge);
    padding: 0.35rem 0.6rem;
    font-size: var(--text-label-sm);
    line-height: 1.35;
    color: var(--ink-62);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    max-width: 100%;
  }
  .placard b {
    color: var(--ink);
    font-weight: 600;
  }
  .wall-cap {
    margin: 0.9rem 0 0;
    font-size: var(--text-body-sm);
    line-height: 1.45;
    color: var(--ink-muted);
    max-width: 62ch;
  }
  /* the lightbox */
  .light {
    width: min(96vw, var(--frame));
    max-width: none;
    max-height: 94vh;
    margin: auto;
    overflow: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-island);
  }
  .light::backdrop {
    background: rgba(20, 22, 26, 0.72);
  }
  .light-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--ink-10);
    font-size: var(--text-label);
    color: var(--ink-muted);
  }
  .light-bar b {
    color: var(--ink);
    font-weight: 600;
  }
  .light-bar button {
    border: 1px solid var(--ink-10);
    background: var(--surface);
    border-radius: var(--radius-control);
    padding: 0.25rem 0.7rem;
    font-size: var(--text-label);
    cursor: pointer;
  }
  .light img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 860px) {
    .wall-row {
      grid-template-columns: 1fr;
    }
    .hang, .wall.is-0 .hang[data-i='0'], .wall.is-1 .hang[data-i='1'], .wall.is-2 .hang[data-i='2'] {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
