---
// Three tracker boards as a deck of cards: the front one is large, the other two wait
// behind it, and every few seconds the next board slides to the front while its
// adapter name lights up in the row above. It says what the static composite could
// not: the same harness sits on all three, one adapter each.
//
// No animation library. The state is a class on the figure (`is-0`, `is-1`, `is-2`)
// and CSS transitions do the moving; the script only advances the class on a timer,
// pauses when the figure is off screen, and stops under reduced motion, where the
// reader gets the front card and can step through with the buttons.
import { UI, type Lang } from '../lib/site';

export interface DeckCard {
  /** Tracker name as shown on the chip: GitHub Issues, Jira, Linear. */
  name: string;
  /** Adapter skill in the harness, e.g. linear-issue-tracker. */
  adapter: string;
  /** Picture under site/public. */
  src: string;
  /** Short note under the name, e.g. "board thật, dự án Inception". */
  note?: string;
}

interface Props {
  lang: Lang;
  cards: DeckCard[];
  caption: string;
  /** Seconds each card stays in front. */
  hold?: number;
  class?: string;
}
const { lang, cards, caption, hold = 4, class: extra = '' } = Astro.props;
---

<figure class:list={['deck', 'is-0', extra]} data-hold={hold} data-count={cards.length}>
  <div class="deck-chips" role="tablist" aria-label={UI.deckLabel[lang]}>
    {cards.map((c, i) => (
      <button class="chip mono" type="button" role="tab" data-i={i} aria-selected={i === 0 ? 'true' : 'false'}>
        <span class="chip-dot" aria-hidden="true" />
        <b>{c.adapter}</b>
        <span class="chip-name">{c.name}</span>
      </button>
    ))}
  </div>
  <div class="deck-stage">
    {cards.map((c, i) => (
      <div class="card" data-i={i}>
        <img src={c.src} alt={`${c.name}${c.note ? ` · ${c.note}` : ''}`} loading="lazy" decoding="async" />
        {c.note && <span class="card-note mono">{c.note}</span>}
      </div>
    ))}
  </div>
  <figcaption class="deck-cap">{caption}</figcaption>
</figure>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('.deck').forEach((deck) => {
    const count = Number(deck.dataset.count || 0);
    const hold = Number(deck.dataset.hold || 4) * 1000;
    const chips = Array.from(deck.querySelectorAll<HTMLButtonElement>('.chip'));
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      i = (n + count) % count;
      deck.className = deck.className.replace(/\bis-\d+\b/, `is-${i}`);
      chips.forEach((c, k) => c.setAttribute('aria-selected', k === i ? 'true' : 'false'));
    };
    const stop = () => { if (timer) { window.clearInterval(timer); timer = undefined; } };
    const start = () => { if (!timer && !reduce.matches) timer = window.setInterval(() => show(i + 1), hold); };
    chips.forEach((c) => c.addEventListener('click', () => { show(Number(c.dataset.i)); stop(); start(); }));
    deck.addEventListener('mouseenter', stop);
    deck.addEventListener('mouseleave', start);
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start() : stop()))).observe(deck);
    } else start();
  });
</script>

<style>
  .deck {
    margin-block: 1.75rem 0;
    padding: 0;
  }
  .deck-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem 0.35rem 0.6rem;
    font-size: var(--text-label);
    color: var(--ink-muted);
    background: var(--surface);
    border: 1px solid var(--ink-10);
    border-radius: var(--radius-control);
    cursor: pointer;
    transition: border-color var(--motion-fast, 160ms) ease, color var(--motion-fast, 160ms) ease;
  }
  .chip b {
    font-weight: 600;
    color: var(--ink);
  }
  .chip-name::before {
    content: '·';
    margin-right: 0.5rem;
    color: var(--ink-35);
  }
  .chip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-22);
    transition: background var(--motion-fast, 160ms) ease;
  }
  .chip[aria-selected='true'] {
    border-color: var(--brand-primary);
    color: var(--ink);
  }
  .chip[aria-selected='true'] .chip-dot {
    background: var(--brand-primary);
  }

  /* The stage keeps the 16:10 of the pictures plus room for the two cards behind. */
  .deck-stage {
    position: relative;
    aspect-ratio: 16 / 10.6;
    perspective: 1400px;
  }
  .card {
    position: absolute;
    inset: 0 4% 0 4%;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--ink-10);
    box-shadow: var(--shadow-island);
    background: var(--surface);
    transition:
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 500ms ease;
    will-change: transform;
  }
  .card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .card-note {
    position: absolute;
    left: 0.7rem;
    bottom: 0.7rem;
    font-size: var(--text-label-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-62);
    background: rgba(255, 255, 255, 0.92);
    border-radius: var(--radius-control);
    padding: 0.2rem 0.55rem;
  }
  /* Positions by role: front, left-behind, right-behind. Which card holds which role
     follows the figure's is-N class, so the transition runs between two static states. */
  .card { z-index: 1; transform: translate3d(0, 0, 0) scale(1); }
  .deck.is-0 .card[data-i='1'], .deck.is-1 .card[data-i='2'], .deck.is-2 .card[data-i='0'] {
    z-index: 0; transform: translate3d(-9%, 6%, 0) scale(0.86) rotateY(6deg); filter: saturate(0.5) brightness(0.96);
  }
  .deck.is-0 .card[data-i='2'], .deck.is-1 .card[data-i='0'], .deck.is-2 .card[data-i='1'] {
    z-index: 0; transform: translate3d(9%, 6%, 0) scale(0.86) rotateY(-6deg); filter: saturate(0.5) brightness(0.96);
  }
  .deck.is-0 .card[data-i='0'], .deck.is-1 .card[data-i='1'], .deck.is-2 .card[data-i='2'] {
    z-index: 2;
  }
  .deck-cap {
    margin: 0.9rem 0 0;
    font-size: var(--text-body-sm);
    line-height: 1.45;
    color: var(--ink-muted);
    max-width: 62ch;
  }
  @media (prefers-reduced-motion: reduce) {
    .card { transition: none; }
  }
</style>
