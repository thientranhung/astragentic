---
import { adopt } from '../lib/data';
import CodeFrame from './CodeFrame.astro';
import { hl } from '../lib/markup';
import { UI, type Lang } from '../lib/site';

interface Requirement {
  name: string;
  tag?: string;
  role?: string;
  href?: string;
}
interface Props {
  lang: Lang;
  /** Owner-written requirement list with what each piece is for; falls back to README data. */
  requirements?: Requirement[];
  reqTitle?: string;
  /** Render only one half when the page splits requirements and install into two sections. */
  show?: 'both' | 'requirements' | 'commands';
}
const { lang, requirements, reqTitle, show = 'both' } = Astro.props;
const reqs: Requirement[] =
  requirements && requirements.length > 0
    ? requirements
    : adopt.prerequisites.map((p) => ({ name: p.version ? `${p.name} ${p.version}` : p.name, href: p.href ?? undefined }));
---

<div class:list={["adopt breakout", { "adopt--split": show !== "both" }]}>
  {(show === 'both' || show === 'requirements') && (
  <div class="col">
    <p class="label mono">{reqTitle ?? UI.prerequisites[lang]}</p>
    <ul class="pre">
      {
        reqs.map((p) => (
          <li class="req-item">
            <div class="req-head">
              {p.href ? (
                <a href={p.href} target="_blank" rel="noreferrer" class="mono name">{p.name}</a>
              ) : (
                <span class="mono name">{p.name}</span>
              )}
              {p.tag && <span class="mono tag">{p.tag}</span>}
            </div>
            {p.role && <p class="role" set:html={hl(p.role)} />}
          </li>
        ))
      }
    </ul>
  </div>
  )}

  {(show === 'both' || show === 'commands') && (
  <div class="col col--wide">
    {/* Split mode gives each half its own h2, so the pane's own caption would repeat it. */}
    <CodeFrame lang={lang} lines={adopt.commands} label={show === 'both' ? UI.quickstart[lang] : undefined} />
  </div>
  )}
</div>

<style>
  /* When the page gives each half its own h2, the inner mono label would repeat it. */
  .adopt--split .label {
    display: none;
  }
  .req-item {
    padding-block: 0.6rem;
  }
  .req-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .tag {
    font-size: var(--text-micro, 10px);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-62);
    white-space: nowrap;
  }
  .name {
    font-weight: 700;
    color: var(--ink);
    font-size: var(--text-ui, 15px);
  }
  .role :global(.hl) {
    color: var(--ink);
    font-weight: 600;
  }
  .role {
    margin: 0.2rem 0 0;
    font-size: var(--text-sm, 14px);
    line-height: 1.5;
    color: var(--ink-70);
  }
  /* Requirements first as a two-column grid, commands below at full width: seven
     requirement rows are taller than four commands, so side by side they never balance. */
  .adopt {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin-block: 2.5rem 0;
    padding: 1.75rem 1.9rem;
    background: var(--surface);
    border: 1px solid var(--ink-10);
    border-radius: 2px;
  }
  .label {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin: 0 0 0.85rem;
  }
  .pre {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
  }
  @media (max-width: 720px) {
    .pre {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .pre li {
    margin: 0 0 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule-faint);
  }
  .pre li:last-child {
    border-bottom: 0;
    margin-bottom: 0;
  }
  .name {
    font-size: var(--text-mono);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  a.name:hover {
    border-bottom-color: var(--ink);
  }
  .ver {
    font-size: var(--text-label);
    color: var(--ink-muted);
  }

  @media (max-width: 760px) {
    .adopt {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
