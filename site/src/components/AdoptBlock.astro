---
import { adopt } from '../lib/data';
import { UI, type Lang } from '../lib/site';

interface Requirement {
  name: string;
  tag?: string;
  role?: string;
  href?: string;
}
interface Props {
  lang: Lang;
  /** Owner-written requirement list with what each piece is for; falls back to README data. */
  requirements?: Requirement[];
  reqTitle?: string;
  /** Render only one half when the page splits requirements and install into two sections. */
  show?: 'both' | 'requirements' | 'commands';
}
const { lang, requirements, reqTitle, show = 'both' } = Astro.props;
const reqs: Requirement[] =
  requirements && requirements.length > 0
    ? requirements
    : adopt.prerequisites.map((p) => ({ name: p.version ? `${p.name} ${p.version}` : p.name, href: p.href ?? undefined }));
const script = adopt.commands.join('\n');
---

<div class:list={["adopt breakout", { "adopt--split": show !== "both" }]}>
  {(show === 'both' || show === 'requirements') && (
  <div class="col">
    <p class="label mono">{reqTitle ?? UI.prerequisites[lang]}</p>
    <ul class="pre">
      {
        reqs.map((p) => (
          <li class="req-item">
            <div class="req-head">
              {p.href ? (
                <a href={p.href} target="_blank" rel="noreferrer" class="mono name">{p.name}</a>
              ) : (
                <span class="mono name">{p.name}</span>
              )}
              {p.tag && <span class="mono tag">{p.tag}</span>}
            </div>
            {p.role && <p class="role">{p.role}</p>}
          </li>
        ))
      }
    </ul>
  </div>
  )}

  {(show === 'both' || show === 'commands') && (
  <div class="col col--wide">
    <div class="cmd-head">
      <p class="label mono">{UI.quickstart[lang]}</p>
      <button
        class="copy mono"
        type="button"
        data-copy
        data-label={UI.copy[lang]}
        data-done={UI.copied[lang]}
        data-payload={script}
      >{UI.copy[lang]}</button>
    </div>
    <ol class="cmds codeframe">
      {
        adopt.commands.map((command) => {
          // The runner is the word the reader types; what follows is the thing being
          // installed. Colouring the second half is the only syntax this site has.
          const cut = command.indexOf(' ');
          const head = cut === -1 ? command : command.slice(0, cut);
          const rest = cut === -1 ? '' : command.slice(cut);
          return (
            <li>
              <pre class="mono" lang="en">{head}<span class="cmd-key">{rest}</span></pre>
            </li>
          );
        })
      }
    </ol>
  </div>
  )}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const payload = button.dataset.payload ?? '';
      try {
        await navigator.clipboard.writeText(payload);
      } catch {
        const box = document.createElement('textarea');
        box.value = payload;
        document.body.append(box);
        box.select();
        document.execCommand('copy');
        box.remove();
      }
      button.textContent = button.dataset.done ?? 'Copied';
      window.setTimeout(() => {
        button.textContent = button.dataset.label ?? 'Copy';
      }, 1600);
    });
  });
</script>

<style>
  /* When the page gives each half its own h2, the inner mono label would repeat it. */
  .adopt--split .label {
    display: none;
  }
  .req-item {
    padding-block: 0.6rem;
  }
  .req-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .tag {
    font-size: var(--text-micro, 10px);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-62);
    white-space: nowrap;
  }
  .role {
    margin: 0.2rem 0 0;
    font-size: var(--text-sm, 14px);
    line-height: 1.5;
    color: var(--ink-70);
  }
  /* Requirements first as a two-column grid, commands below at full width: seven
     requirement rows are taller than four commands, so side by side they never balance. */
  .adopt {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin-block: 2.5rem 0;
    padding: 1.75rem 1.9rem;
    background: var(--surface);
    border: 1px solid var(--ink-10);
    border-radius: 2px;
  }
  .label {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    margin: 0 0 0.85rem;
  }
  .pre {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
  }
  @media (max-width: 720px) {
    .pre {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .pre li {
    margin: 0 0 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule-faint);
  }
  .pre li:last-child {
    border-bottom: 0;
    margin-bottom: 0;
  }
  .name {
    font-size: var(--text-mono);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  a.name:hover {
    border-bottom-color: var(--ink);
  }
  .ver {
    font-size: var(--text-label);
    color: var(--ink-muted);
  }

  .cmd-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .copy {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    background: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: 0.55rem 0.9rem;
    min-height: 36px;
    cursor: pointer;
  }
  @media (pointer: coarse) {
    .copy {
      min-height: var(--row-h);
      padding-inline: 1rem;
    }
  }
  .copy:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .cmds {
    list-style: none;
    counter-reset: step;
    margin: 0.85rem 0 0;
  }
  .cmds li {
    counter-increment: step;
    position: relative;
    padding-left: 3.1rem;
    margin: 0;
  }
  .cmds li + li {
    border-top: 1px solid var(--ink-05);
  }
  .cmds li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 1.1rem;
    top: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--ink-62);
  }
  .cmds pre {
    font-size: var(--text-mono);
    padding: 0.45rem 1.1rem 0.45rem 0;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: visible;
  }

  @media (max-width: 760px) {
    .adopt {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }
</style>
