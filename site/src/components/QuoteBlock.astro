---
// A verbatim quote from the repo. Never translated (spec §1 rule 3); the source line
// is a link into the file on GitHub so the reader can check it.
interface Props {
  source: string;
  href?: string;
  size?: 'lg' | 'md' | 'sm';
  /** The mono label that marks the block as untranslated source text — on a
   *  Vietnamese page this reads "nguyên văn · tiếng Anh" (PRD §4). */
  label?: string;
}
const { source, href, size = 'lg', label } = Astro.props;
---

<figure class:list={['quote', `quote--${size}`]}>
  {label && <p class="mono vlabel">{label}</p>}
  <blockquote lang="en"><slot /></blockquote>
  <figcaption class="mono">
    {href ? <a href={href} target="_blank" rel="noreferrer">{source} ↗</a> : source}
  </figcaption>
</figure>

<style>
  .quote {
    margin: 0 0 2.25rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--ink-22);
  }
  /* Spec 6 §4 keeps the serif for titles only; a pulled quote is body voice, said
     larger. */
  .quote blockquote {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: -0.018em;
    line-height: 1.3;
    text-wrap: balance;
    color: var(--ink);
  }
  /* Both endpoints of a fluid size have to be steps on the ramp, or the ramp is not a
     ramp. The medium quote's old range was 19-23px, four pixels of fluidity that never
     paid for an off-scale endpoint, so it is one step now. */
  .quote--lg blockquote {
    font-size: clamp(var(--text-h2), 2.6vw, var(--text-h1));
  }
  .quote--md blockquote {
    font-size: var(--text-h3);
  }
  .quote--sm blockquote {
    font-size: var(--text-body);
    line-height: 1.5;
    letter-spacing: 0;
  }
  .vlabel {
    margin: 0 0 0.6rem;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
  }
  figcaption {
    margin-top: 1.1rem;
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  figcaption a {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  figcaption a:hover {
    color: var(--ink);
  }
</style>
