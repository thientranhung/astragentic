---
import { entryBody, entryExcerpt, entryHtml, ledgerHref, type LedgerRow } from '../lib/data';
import { ROUTES, type Lang } from '../lib/site';

interface Props {
  row: LedgerRow;
  lang: Lang;
  /** 'lg' breaks the reading column (screen 1, /loi). 'sm' hangs under a stage. */
  size?: 'lg' | 'sm';
  /** English cost line from failures.json, printed under the entry on /loi. */
  costLine?: string;
  /** One Vietnamese/English sentence of the writer's, already HTML. */
  noteHtml?: string;
  /** Where the AST code points. Defaults to the ledger table row on /evidence. */
  href?: string;
  anchorId?: string;
  /** 'sm' cards on the rail sit in a 7-column grid; drop the excerpt there. */
  compact?: boolean;
}
const { row, lang, size = 'lg', costLine, noteHtml, href, anchorId, compact = false } = Astro.props;

const slug = row.id.toLowerCase();
const target = href ?? `${ROUTES.evidence[lang]}#${slug}`;
const body = entryExcerpt(row, size === 'lg' ? 460 : 150);
const promoted = row.promotedOn ? `promoted ${row.promotedOn}` : row.status;
---

{
  size === 'lg' ? (
    <article class="card card--lg" id={anchorId}>
      <header class="head">
        <a href={target} class="ast id">{row.id}</a>
        <span class="meta">{promoted}</span>
      </header>

      {/* Entry title and body stay verbatim English in both locales (spec §1 rule 3). */}
      <h3 class="lesson" lang="en">{row.lesson}</h3>
      <blockquote class="entry mono" lang="en" set:html={entryHtml(body)} />

      {costLine && <p class="cost" lang="en">{costLine}</p>}
      {noteHtml && <div class="note" set:html={noteHtml} />}

      <footer class="foot mono">
        <a href={ledgerHref(row)} target="_blank" rel="noreferrer" class="src">
          INDEX.md:{row.indexLine}
        </a>
        <span class="dot">·</span>
        <span>{row.words} words</span>
        {row.refs.length > 0 && (
          <>
            <span class="dot">·</span>
            <span class="cited">
              cited by{' '}
              {row.refs.map((ref, i) => (
                <>
                  {i > 0 && ', '}
                  {ref.href ? (
                    <a
                      href={ref.href}
                      class="ref"
                      target={ref.kind === 'file' ? '_blank' : undefined}
                      rel={ref.kind === 'file' ? 'noreferrer' : undefined}
                    >
                      {ref.name}
                    </a>
                  ) : (
                    <span>{ref.name}</span>
                  )}
                </>
              ))}
            </span>
          </>
        )}
      </footer>
    </article>
  ) : (
    <a class="card card--sm" href={target} id={anchorId}>
      <span class="ast id">{row.id}</span>
      <span class="lesson-sm" lang="en">{row.lesson}</span>
      {!compact && <span class="excerpt mono" lang="en" set:html={entryHtml(body)} />}
    </a>
  )
}

<style>
  .card {
    border: 1px solid var(--defect);
    border-radius: 6px;
    background: var(--surface);
    display: block;
  }

  .card--lg {
    padding: 1.75rem 1.9rem 1.5rem;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }
  .id {
    font-size: 15px;
    letter-spacing: 0.06em;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .lesson {
    font-size: 26px;
    line-height: 1.2;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .entry {
    margin: 0 0 1.15rem;
    padding: 0.95rem 1.1rem;
    background: var(--paper-sunk);
    border: 0;
    border-left: 2px solid var(--rule);
    font-size: 13.5px;
    line-height: 1.62;
    white-space: pre-wrap;
    color: var(--ink);
  }

  .cost {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--ink-muted);
    margin: 0 0 1.1rem;
  }

  .note {
    font-size: 19px;
    line-height: 1.6;
  }
  .note :global(p) {
    margin: 0 0 0.8rem;
  }
  .note :global(p:last-child) {
    margin-bottom: 0;
  }

  .foot {
    margin-top: 1.35rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: 11.5px;
    line-height: 1.9;
    color: var(--ink-muted);
  }
  .foot .dot {
    margin-inline: 0.45rem;
    color: var(--rule);
  }
  .foot .src {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .foot .src:hover {
    color: var(--ink);
  }
  .foot .ref {
    color: var(--pass);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--pass) 40%, transparent);
  }
  .foot .ref:hover {
    border-bottom-color: var(--pass);
  }

  /* small card — one per failure hanging under its stage on the rail */
  .card--sm {
    padding: 0.85rem 0.9rem 0.95rem;
    text-decoration: none;
    color: inherit;
  }
  .card--sm:hover {
    background: var(--paper-sunk);
  }
  .card--sm .id {
    display: block;
    font-size: 12.5px;
    margin-bottom: 0.4rem;
    border-bottom: 0;
  }
  .lesson-sm {
    display: block;
    font-size: 15px;
    line-height: 1.35;
    letter-spacing: -0.005em;
    margin-bottom: 0.45rem;
  }
  .excerpt {
    display: block;
    font-size: 11px;
    line-height: 1.55;
    color: var(--ink-muted);
  }
</style>
