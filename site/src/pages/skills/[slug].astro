---
import { getCollection } from 'astro:content';
import SkillBody from '../../components/pages/SkillBody.astro';
import { getSkillCards } from '../../lib/skills';

/** One page per skill name, always — the catalog is the source of the list, and the
 *  content file fills it in when the writer has landed it. */
export async function getStaticPaths() {
  const cards = await getSkillCards('vi');
  const entries = await getCollection('skills');
  const find = (name: string) => entries.find((entry) => entry.id === `vi/${name}`);
  return cards.map((card) => ({
    params: { slug: card.name },
    props: { name: card.name, line: card.line, group: card.group, entry: find(card.name) },
  }));
}

const { name, line, group, entry } = Astro.props;
---

<SkillBody lang="vi" name={name} line={line} group={group} entry={entry} />
