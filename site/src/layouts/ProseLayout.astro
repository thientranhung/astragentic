---
// /dictionary/<term> — the English-only reference set. Read mode (design spec 5 §2),
// with the term's own facts in the meta card and the site tree in the left rail, so a
// dictionary page is not a second site with its own furniture.
import DocsLayout from './DocsLayout.astro';
import type { Lang } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  sourcePath?: string;
  runtimes?: string[];
  updated?: Date;
  /** The Vietnamese page nearest this term, when it has one — not a translation, so
   *  it drives the language switch only (src/lib/terms.ts). */
  switchTo?: Record<Lang, string>;
}
const { title, description, eyebrow, sourcePath, runtimes, updated, switchTo } = Astro.props;
const hasMeta = Boolean(sourcePath || (runtimes && runtimes.length) || updated);
---

<DocsLayout
  title={title}
  description={description}
  lang="en"
  switchTo={switchTo}
  eyebrow={eyebrow}
  lede={description}
>
  <div class:list={['term', hasMeta && 'term--meta']}>
    <article class="prose read-body">
      <slot />
    </article>

    {
      hasMeta && (
        <aside class="meta" data-toc-skip>
          <dl>
            {sourcePath && (
              <div>
                <dt class="mono">Source</dt>
                <dd class="mono">{sourcePath}</dd>
              </div>
            )}
            {runtimes && runtimes.length > 0 && (
              <div>
                <dt class="mono">Runtimes</dt>
                <dd class="mono">{runtimes.join(', ')}</dd>
              </div>
            )}
            {updated && (
              <div>
                <dt class="mono">Updated</dt>
                <dd class="mono">{updated.toISOString().slice(0, 10)}</dd>
              </div>
            )}
          </dl>
        </aside>
      )
    }
  </div>
</DocsLayout>

<style>
  .term--meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 10rem;
    gap: 2rem;
    align-items: start;
  }
  .meta {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    padding-left: 1.25rem;
    border-left: 1px solid var(--rule);
  }
  .meta dl {
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .meta dt {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
  }
  .meta dd {
    margin: 0;
    font-size: 12px;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .read-body :global(h2) {
    font-size: 22px;
    margin-top: var(--section-gap);
    margin-bottom: 0.5rem;
  }
  .read-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
    font-size: 14px;
  }
  .read-body :global(th),
  .read-body :global(td) {
    border-bottom: 1px solid var(--rule);
    padding: 0.45rem 0.75rem 0.45rem 0;
    text-align: left;
    vertical-align: top;
  }

  @media (max-width: 760px) {
    .term--meta {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    .meta {
      order: -1;
      position: static;
      padding: 0.9rem 1rem;
      border-left: 0;
      border: 1px solid var(--rule);
      border-radius: 2px;
      background: var(--paper-sunk);
    }
  }
</style>
