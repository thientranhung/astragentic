{
  // Cloudflare Workers static assets. Deploy: pnpm deploy
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astragentic",
  "account_id": "6c1e5df447e1aad46009468a8f9a100c",
  "compatibility_date": "2026-09-11",
  // Zone thisistool.com nằm cùng account: Cloudflare tự tạo DNS và cấp SSL.
  "routes": [
    { "pattern": "astragentic.thisistool.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
