{
  "$description": "Astragentic design tokens. W3C Design Tokens Community Group shape ($type / $value, {group.token} aliases). Dimensions and durations are serialised as CSS strings rather than {value,unit} objects because several of them are clamp() expressions that the object form cannot hold; keeping one representation is worth more here than partial conformance. `$extensions.site.cssVar` pins the custom-property name a token compiles to, so the names components already use survive. Run `pnpm tokens` to regenerate src/styles/tokens.css; never hand-edit that file.",
  "color": {
    "$type": "color",
    "brand": {
      "$description": "Astraler's logo red, measured off astraler.com (CSS rgb(229,54,37); dominant pixel of the logo PNG #E43424). Astragentic is Astraler's product, so the product site borrows the parent brand's one colour. The red is spent in two steps and the split is a measurement, not a taste: white on #E53625 is 4.30:1, which clears the 3:1 floor for a mark and misses the 4.5:1 floor for words. So `primary` draws marks — bars, strokes, rings, underlines — and `primary-hover` (5.41:1 white-on, 5.41:1 on white) is the step that is allowed to carry text or sit under a label.",
      "primary": {
        "$value": "#E53625"
      },
      "primary-hover": {
        "$value": "#C92D1F"
      },
      "primary-press": {
        "$value": "#A82014",
        "$description": "A filled brand button under the cursor. 7.29:1 with white on it."
      },
      "primary-soft": {
        "$value": "#FBE9E6"
      },
      "on-primary": {
        "$value": "#FFFFFF"
      }
    },
    "canvas": {
      "$description": "The graph-paper desk the page island sits on. Pass 7 first cooled it to a neutral blue-grey; the site owner asked for the brand to reach the desk too, so the three stops are a warm ramp out of the Astraler red instead. The island and everything on it stay neutral — the red is the room, not the paper.",
      "base": {
        "$value": "#F2F3F6",
        "$extensions": {
          "site": {
            "cssVar": "--canvas"
          }
        }
      },
      "grid-a": {
        "$value": "#FDF1EE",
        "$extensions": {
          "site": {
            "cssVar": "--grid-a"
          }
        }
      },
      "grid-b": {
