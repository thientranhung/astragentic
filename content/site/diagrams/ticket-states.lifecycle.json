      "toSide": "top",
      "route": "straight",
      "labelDy": 24
    },
    {
      "id": "lost-retry",
      "from": "lost_race",
      "to": "unclaimed",
      "label": "take the next ticket",
      "variant": "dashed",
      "route": "bottom-channel",
      "channelY": 470,
      "toSide": "bottom",
      "fromSide": "bottom"
    },
    {
      "id": "failed-retry",
      "from": "branch_failed",
      "to": "unclaimed",
      "label": "assignee reset, worktree removed",
      "variant": "dashed",
      "route": "bottom-channel",
      "channelY": 530,
      "toSide": "bottom",
      "fromSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "The Claim Comes First",
      "items": [
        "Assigning a ticket is the claim, and it happens before its worktree exists",
        "The readback is what makes the claim advisory rather than trusted blindly",
        "Branch creation is the atomic step that actually decides a same-second race"
      ]
    },
    {
      "dot": "rose",
      "title": "Two Ways to Lose It",
      "items": [
        "A different assignee on readback means another dispatcher already won",
        "A refused branch means the branch already exists under that name",
        "Both release the claim; neither one blocks the ticket forever"
      ]
    },
    {
      "dot": "emerald",
      "title": "What a Won Claim Leaves",
      "items": [
        "A worktree and branch that are this Builder's alone to write",
        "A merge that clears the assignee and writes a Ledger line",
        "No tracker natively holds a lock — the readback plus branch creation is the interlock"
      ]
    }
  ]
}