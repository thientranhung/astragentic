    "quality_profile": "showcase",
    "views": [
      {
        "id": "the-claim",
        "label": "The claim protocol",
        "focus": [
          "unclaimed",
          "claimed",
          "readback",
          "worktree"
        ],
        "note": "Assigning a ticket is the claim, and it happens before its worktree exists."
      },
      {
        "id": "when-it-fails",
        "label": "When the claim is lost",
        "focus": [
          "readback",
          "lost_race",
          "worktree",
          "branch_failed"
        ],
        "note": "A different assignee, or a branch that already exists, both release the claim."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Claim lifecycle"
    },
    {
      "id": "contest",
      "label": "Lost claim"
    }
  ],
  "states": [
    {
      "id": "unclaimed",
      "type": "start",
      "label": "Unclaimed",
      "sublabel": "on the frontier",
      "lane": "main",
      "col": 0
    },
    {
      "id": "claimed",
      "type": "active",
      "label": "Claimed",
      "sublabel": "assignee written",
      "lane": "main",
      "col": 1
    },
    {
      "id": "readback",
