      "label": "Readback",
      "sublabel": "assignee re-read",
      "lane": "main",
      "col": 2
    },
    {
      "id": "worktree",
      "type": "active",
      "label": "Worktree",
      "sublabel": "branch + worktree add",
      "lane": "main",
      "col": 3
    },
    {
      "id": "merged",
      "type": "success",
      "label": "Merged",
      "sublabel": "Ledger line written",
      "lane": "main",
      "col": 4
    },
    {
      "id": "lost_race",
      "type": "failure",
      "label": "Claim Lost",
      "sublabel": "another assignee won",
      "lane": "contest",
      "col": 0
    },
    {
      "id": "branch_failed",
      "type": "failure",
      "label": "Branch Refused",
      "sublabel": "branch already exists",
      "lane": "contest",
      "col": 1
    }
  ],
  "transitions": [
    {
      "id": "write-assignee",
