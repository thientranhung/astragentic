{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "The Frontier Query",
    "output": "frontier-query.html",
    "viewBox": [
      1080,
      640
    ],
    "quality_profile": "showcase",
    "views": [
      {
        "id": "the-inputs",
        "label": "What the query reads",
        "focus": [
          "tickets",
          "blocking_edges",
          "assignee_field",
          "frontier_query"
        ],
        "note": "Every ticket whose blockers are all done and whose assignee is empty."
      },
      {
        "id": "who-reruns-it",
        "label": "Who re-runs it, and when",
        "focus": [
          "frontier_query",
          "board",
          "thomas",
          "owner"
        ],
        "note": "At session start, and again the moment a ticket closes."
      },
      {
        "id": "the-loop",
        "label": "The loop",
        "focus": [
          "board",
          "builder",
          "tickets"
        ],
        "note": "The Builder claims from the board; an issue found while working is written back as a new ticket, and the next query sees it."
      }
    ]
  },
  "stages": [
    {
      "label": "Tracker fields"
    },
    {
      "label": "Query"
    },
    {
      "label": "Board"
    },
    {
      "label": "Consume"
    }
  ],
  "nodes": [
    {
      "id": "tickets",
      "type": "database",
      "label": "Open Tickets",
      "sublabel": "all tracker items",
      "stage": 0,
      "row": 0
    },
    {
      "id": "blocking_edges",
      "type": "database",
      "label": "Blocking Edges",
      "sublabel": "blocked_by graph",
      "stage": 0,
      "row": 1
    },
    {
      "id": "assignee_field",
      "type": "database",
      "label": "Assignee Field",
      "sublabel": "empty or held",
      "stage": 0,
      "row": 2
    },
    {
      "id": "frontier_query",
      "type": "backend",
      "label": "Frontier Query",
      "sublabel": "asks what is ready",
      "stage": 1,
      "row": 1,
      "tag": "not remembered"
    },
    {
      "id": "board",
      "type": "cloud",
      "label": "Claimable Board",
      "sublabel": "claimable, unclaimed",
      "stage": 2,
      "row": 1,
      "width": 120
    },
    {
      "id": "thomas",
      "type": "backend",
      "label": "Thomas",
      "sublabel": "reruns after merge/handback",
      "stage": 3,
      "row": 0,
      "width": 140
    },
    {
      "id": "builder",
      "type": "backend",
      "label": "Builder",
      "sublabel": "claims and works the ticket",
      "stage": 3,
      "row": 1,
      "width": 140
    },
    {
      "id": "owner",
      "type": "external",
      "label": "Owner",
      "sublabel": "looks at the board",
      "stage": 3,
      "row": 2
    }
  ],
  "flows": [
    {
      "id": "all-tickets",
      "from": "tickets",
      "to": "frontier_query",
      "label": "every open ticket",
      "classification": "state read"
    },
    {
      "id": "blockers-done",
      "from": "blocking_edges",
      "to": "frontier_query",
      "label": "blockers all done?",
      "classification": "graph read",
      "labelAt": [
        300,
        314
      ]
    },
    {
      "id": "assignee-empty",
      "from": "assignee_field",
      "to": "frontier_query",
      "label": "assignee empty?",
      "classification": "state read"
    },
    {
      "id": "answer-written",
      "from": "frontier_query",
      "to": "board",
      "label": "answer written",
      "classification": "derived"
    },
    {
      "id": "board-thomas",
      "from": "board",
      "to": "thomas",
      "label": "session start + ticket closes",
      "classification": "polled"
    },
    {
      "id": "board-owner",
      "from": "board",
      "to": "owner",
      "label": "reviews readiness",
      "classification": "read-only"
    },
    {
      "id": "board-builder",
      "from": "board",
      "to": "builder",
      "label": "claim, then dispatch",
      "classification": "writes assignee",
      "labelAt": [860, 225]
    },
    {
      "id": "new-ticket",
      "from": "builder",
      "to": "tickets",
      "label": "issue found → new ticket",
      "classification": "writes",
      "fromSide": "right",
      "toSide": "left",
      "via": [
        [850, 271],
        [850, 590],
        [20, 590],
        [20, 157]
      ],
      "labelAt": [435, 590]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Ready, Not Remembered",
      "items": [
        "The frontier is every ticket whose blockers are all done and whose assignee is empty",
        "Thomas asks the tracker, instead of remembering what used to be ready",
        "The query re-runs at session start and again when a ticket closes"
      ]
    },
    {
      "dot": "emerald",
      "title": "State Lives on the Tracker",
      "items": [
        "Open tickets, blocking edges, and the assignee field are the only inputs",
        "The board is written to the tracker's claimable-and-unclaimed state",
        "Promotion after a spec still needs Thomas's judgement — edges are over-inclusive",
        "A Builder claims from the board, and an issue found while working goes back as a new ticket"
      ]
    },
    {
      "dot": "rose",
      "title": "The Owner Reads the Board",
      "items": [
        "The owner looks at what Thomas wrote, not at a live query",
        "A readiness label at creation time is never revisited by this query",
        "Read edges and state, never the readiness label"
      ]
    }
  ]
}