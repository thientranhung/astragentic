  "cards": [
    {
      "dot": "cyan",
      "title": "Thứ Tự Cố Định",
      "items": [
        "Claim quyết định quyền sở hữu trước khi worktree tồn tại",
        "Mọi ticket đi qua đủ bảy chốt kiểm, không ngoại lệ",
        "Đường vui vẻ là đường duy nhất được vẽ ra — race và claim lỗi thời sống trong văn xuôi"
      ]
    },
    {
      "dot": "emerald",
      "title": "Mỗi Bước Để Lại Một Artifact",
      "items": [
        "Claim: assignee được ghi, rồi đọc lại",
        "Simplify: một commit đánh dấu tên lượt chạy",
        "Merge: một dòng Ledger, và assignee được xóa"
      ]
    },
    {
      "dot": "rose",
      "title": "Một Vòng, Ba Lớp",
      "items": [
        "Code-review, simplify, và cánh tay chéo vendor chạy đúng một lần mỗi cái, theo thứ tự",
        "Không lặp: một finding chặn thì đẩy lên chủ, không bao giờ quay vòng thêm",
        "Builder tự bắn cánh tay của mình, khép vòng lặp của chính nó trước khi handback"
      ]
    }
  ]
}
