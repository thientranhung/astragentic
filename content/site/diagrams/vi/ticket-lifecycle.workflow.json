      {
        "id": "the-review-ladder",
        "label": "Thang review",
        "focus": [
          "code_review",
          "simplify",
          "arm"
        ],
        "note": "Một vòng, ba lớp, đúng thứ tự — không lặp lại."
      },
      {
        "id": "merge",
        "label": "Nơi nó cập bến",
        "focus": [
          "arm",
          "merge"
        ],
        "note": "Merge là bước duy nhất Builder không bao giờ tự làm."
      }
    ]
  },
