  "edges": [
    {
      "from": "claim",
      "to": "brief"
    },
    {
      "from": "brief",
      "to": "implement"
    },
    {
      "from": "implement",
      "to": "code_review"
    },
    {
      "from": "code_review",
      "to": "simplify"
    },
    {
      "from": "simplify",
      "to": "arm"
    },
    {
      "from": "arm",
      "to": "merge",
      "label": "handback"
    }
