      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelDy": 24
    },
    {
      "id": "lost-retry",
      "from": "lost_race",
      "to": "unclaimed",
      "label": "lấy ticket kế tiếp",
      "variant": "dashed",
      "route": "bottom-channel",
      "channelY": 470,
      "toSide": "bottom",
      "fromSide": "bottom"
    },
    {
      "id": "failed-retry",
      "from": "branch_failed",
      "to": "unclaimed",
      "label": "reset assignee, xóa worktree",
      "variant": "dashed",
      "route": "bottom-channel",
      "channelY": 530,
      "toSide": "bottom",
      "fromSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Claim Đến Trước",
      "items": [
        "Gán một ticket chính là claim, và nó xảy ra trước khi worktree tồn tại",
        "Đọc lại là thứ khiến claim chỉ mang tính khuyến nghị, không được tin mù quáng",
        "Tạo branch là bước atomic thực sự quyết định một race xảy ra cùng giây"
      ]
    },
    {
      "dot": "rose",
      "title": "Hai Cách Để Mất Nó",
      "items": [
        "Một assignee khác khi đọc lại nghĩa là một dispatcher khác đã thắng trước rồi",
        "Một branch bị từ chối nghĩa là branch đã tồn tại dưới tên đó",
        "Cả hai đều làm mất claim; không cái nào chặn ticket mãi mãi"
      ]
    },
    {
      "dot": "emerald",
      "title": "Một Claim Thắng Để Lại Gì",
      "items": [
        "Một worktree và branch chỉ Builder này được viết vào",
        "Một merge xóa assignee và ghi một dòng Ledger",
        "Không tracker nào có lock sẵn — đọc lại cộng tạo branch chính là cái khóa liên động"
      ]
    }
  ]
}
