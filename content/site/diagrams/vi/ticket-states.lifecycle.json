          "readback",
          "worktree"
        ],
        "note": "Gán một ticket chính là claim, và nó xảy ra trước khi worktree tồn tại."
      },
      {
        "id": "when-it-fails",
        "label": "Khi claim mất",
        "focus": [
          "readback",
          "lost_race",
          "worktree",
          "branch_failed"
        ],
        "note": "Một assignee khác, hoặc một branch đã tồn tại, cả hai đều làm mất claim."
      }
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Vòng đời claim"
    },
    {
      "id": "contest",
      "label": "Mất claim"
    }
  ],
  "states": [
    {
      "id": "unclaimed",
      "type": "start",
      "label": "Chưa Claim",
      "sublabel": "trên frontier",
      "lane": "main",
      "col": 0
    },
    {
      "id": "claimed",
      "type": "active",
      "label": "Đã Claim",
      "sublabel": "assignee đã ghi",
      "lane": "main",
      "col": 1
    },
    {
      "id": "readback",
      "type": "decision",
      "label": "Đọc Lại",
      "sublabel": "assignee được đọc lại",
      "lane": "main",
      "col": 2
    },
    {
      "id": "worktree",
      "type": "active",
      "label": "Worktree",
      "sublabel": "branch + worktree add",
      "lane": "main",
      "col": 3
    },
    {
      "id": "merged",
      "type": "success",
      "label": "Đã Merge",
      "sublabel": "dòng Ledger đã ghi",
      "lane": "main",
      "col": 4
    },
    {
      "id": "lost_race",
      "type": "failure",
      "label": "Mất Claim",
      "sublabel": "assignee khác thắng",
      "lane": "contest",
      "col": 0
    },
    {
      "id": "branch_failed",
      "type": "failure",
      "label": "Branch Bị Từ Chối",
      "sublabel": "branch đã tồn tại",
