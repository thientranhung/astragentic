      "from": "claimed",
      "to": "readback",
      "label": "đọc lại ticket",
      "labelDy": 75
    },
    {
      "id": "match-create",
      "from": "readback",
      "to": "worktree",
      "label": "đọc lại khớp",
      "labelDy": 75
    },
    {
      "id": "worktree-merge",
      "from": "worktree",
      "to": "merged",
      "label": "merge",
      "labelDy": 75
    },
    {
      "id": "mismatch",
      "from": "readback",
      "to": "lost_race",
      "label": "assignee khác",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelDy": 24
    },
    {
      "id": "branch-exists",
      "from": "worktree",
      "to": "branch_failed",
      "label": "branch bị từ chối",
