  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime Is a Choice, Not a Dependency",
      "items": [
        "Claude Code, Codex, and OpenCode all drive the same harness underneath",
        "Roles, skills, hooks, and the ledger are runtime-agnostic — nothing here is Claude-only",
        "Swapping runtimes mid-project changes the driver seat, not the harness"
      ]
    },
    {
      "dot": "emerald",
      "title": "The Ledger Is Not a Log",
      "items": [
        "Every hook receipt and every gate decision lands in memory/ledger, not just stdout",
        "Skills and roles are read at session start, not baked into a fixed binary",
        "16 skills stay reusable across every role that needs them"
      ]
    },
    {
      "dot": "rose",
      "title": "Coordination Lives Outside the Pane",
      "items": [
        "The tracker is the state substrate; herdr panes and worktrees are disposable",
        "Every claim is written to the tracker before a worktree is even created",
        "Hooks gate the boundary between the harness and your actual project repo"
      ]
    }
  ]
