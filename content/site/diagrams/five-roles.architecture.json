  "cards": [
    {
      "dot": "cyan",
      "title": "Session Lifespans",
      "items": [
        "Thomas never closes — tracker, frontier and dispatch record live with it",
        "Shaper holds one unbroken session from grill to tickets, no /compact",
        "Builder gets exactly one session per ticket, cleared after handback"
      ]
    },
    {
      "dot": "emerald",
      "title": "Concurrency, Not Seniority",
      "items": [
        "Roles follow session boundaries, not rank — every spine step needs an agent playing the human at that step",
        "Several Builders can be dispatched at once, each sole writer in its own worktree",
        "Thomas is the only role a Builder, Rin or QA session ever hands back to"
      ]
    },
    {
      "dot": "rose",
      "title": "Gates Are Milestone- and Walk-Scoped",
      "items": [
        "Rin runs read-only, in a detached worktree, once per milestone — never per ticket",
        "QA exercises journeys and contracts against the running product, not the diff",
        "Neither gate loops — a blocking finding escalates to the owner, not to another round"
      ]
    }
