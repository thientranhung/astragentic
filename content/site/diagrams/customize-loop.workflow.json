{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Customize once, re-install every time",
    "output": "customize-loop.html",
    "quality_profile": "showcase",
    "subtitle": "Immutable: a staged release never changes at the same VERSION, and staging touches no project file; a change means a new VERSION."
  },
  "lanes": [
    {
      "id": "checkout",
      "label": "Astragentic checkout"
    },
    {
      "id": "project",
      "label": "Your project"
    }
  ],
  "mainPath": [
    "edit",
    "bump",
    "install",
    "adapt",
    "keep",
    "run",
    "observe"
  ],
  "nodes": [
    {
      "id": "edit",
      "lane": "checkout",
      "col": 0,
      "type": "frontend",
      "label": "Edit the scaffold",
      "sublabel": "roles \u00b7 contracts \u00b7 skills \u00b7 hooks",
      "width": 150
    },
    {
      "id": "bump",
      "lane": "checkout",
      "col": 1,
      "type": "backend",
      "label": "Bump VERSION",
