      "width": 155
    },
    {
      "id": "adapt",
      "lane": "project",
      "col": 2,
      "type": "frontend",
      "label": "ADAPT-HARNESS.md",
      "sublabel": "compares vs. applied release",
      "width": 135
    },
    {
      "id": "keep",
      "lane": "project",
      "col": 3,
      "type": "frontend",
      "label": "Your files kept",
      "sublabel": "kept: orchestrator.md; drift flagged",
      "width": 158
    },
    {
      "id": "run",
      "lane": "project",
      "col": 4,
      "type": "frontend",
      "label": "Runs new release",
      "sublabel": "applied-version recorded",
      "width": 125
    },
    {
      "id": "observe",
      "lane": "project",
      "col": 5,
      "type": "external",
      "label": "Observe the team",
