      "id": "guard_decision",
      "label": "git guard decision",
      "lane": "tool_call",
      "fromCol": 2,
      "toCol": 3,
      "variant": "security"
    }
  ],
  "mainPath": [
    "bash_cmd",
    "PreToolUse",
    "gitguard",
    "run"
  ],
  "nodes": [
    {
