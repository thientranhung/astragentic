    {
      "from": "gitguard",
      "to": "run",
      "label": "clean"
    },
    {
      "from": "gitguard",
      "to": "block",
      "label": "dangerous pattern",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "WorktreeRemove",
      "to": "release",
      "label": "runs the release script"
    },
    {
      "from": "SessionStart",
      "to": "reload",
