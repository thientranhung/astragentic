{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "One Ticket, Seven Checkpoints",
    "output": "ticket-lifecycle.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "before-code",
        "label": "Before any code exists",
        "focus": [
          "claim",
          "brief"
        ],
        "note": "Ownership is decided before a worktree exists."
      },
      {
        "id": "the-review-ladder",
        "label": "The review ladder",
        "focus": [
          "code_review",
          "simplify",
          "arm"
        ],
        "note": "One round, three layers, in fixed order — no loop."
      },
      {
        "id": "merge",
        "label": "Where it lands",
        "focus": [
          "arm",
          "merge"
        ],
        "note": "Merge is the only step a Builder never performs itself."
      }
    ]
  },
  "lanes": [
    {
      "id": "thomas",
      "label": "Thomas"
    },
    {
      "id": "builder",
      "label": "Builder"
    }
  ],
  "groups": [
    {
      "id": "review_ladder",
      "label": "Review ladder — one round",
      "lane": "builder",
      "fromCol": 3,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "claim",
    "brief",
    "implement",
    "code_review",
    "simplify",
    "arm",
    "merge"
  ],
  "nodes": [
    {
      "id": "claim",
      "lane": "thomas",
      "col": 0,
      "type": "backend",
      "label": "Claim",
      "sublabel": "assignee written + read back",
      "width": 130
    },
    {
      "id": "brief",
      "lane": "thomas",
      "col": 1,
      "type": "backend",
      "label": "Brief",
      "sublabel": "dispatch into pane, at Base",
      "width": 130
    },
    {
      "id": "merge",
      "lane": "thomas",
      "col": 5,
      "type": "backend",
      "label": "Merge",
      "sublabel": "Ledger line, assignee cleared",
      "width": 130
    },
    {
      "id": "implement",
      "lane": "builder",
      "col": 2,
      "type": "frontend",
      "label": "Implement",
      "sublabel": "commits on ticket branch",
      "width": 130
    },
    {
      "id": "code_review",
      "lane": "builder",
      "col": 3,
      "type": "security",
      "label": "Code-review",
      "sublabel": "Standards + Spec, one pass",
      "width": 130
    },
    {
      "id": "simplify",
      "lane": "builder",
      "col": 4,
      "type": "security",
      "label": "Simplify",
      "sublabel": "simplify(increment): commit",
      "width": 130
    },
    {
      "id": "arm",
      "lane": "builder",
      "col": 5,
      "type": "security",
      "label": "Cross-vendor arm",
      "sublabel": "arm(ticket): receipt",
      "width": 130
    }
  ],
  "edges": [
    {
      "from": "claim",
      "to": "brief"
    },
    {
      "from": "brief",
      "to": "implement"
    },
    {
      "from": "implement",
      "to": "code_review"
    },
    {
      "from": "code_review",
      "to": "simplify"
    },
    {
      "from": "simplify",
      "to": "arm"
    },
    {
      "from": "arm",
      "to": "merge",
      "label": "handback"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Fixed Order",
      "items": [
        "Claim decides ownership before a worktree exists",
        "Every ticket passes all seven checkpoints, no exceptions",
        "The happy path is the only path drawn — races and stale claims live in prose"
      ]
    },
    {
      "dot": "emerald",
      "title": "Every Step Leaves an Artifact",
      "items": [
        "Claim: assignee written, then read back",
        "Simplify: a marker commit naming the pass that ran",
        "Merge: a Ledger line, and the assignee cleared"
      ]
    },
    {
      "dot": "rose",
      "title": "One Round, Three Layers",
      "items": [
        "Code-review, simplify, and the cross-vendor arm run once each, in order",
        "No loop: a blocking finding goes to the owner, never to another round",
        "The Builder fires the arm itself, closing its own loop before handback"
      ]
    }
  ]
}