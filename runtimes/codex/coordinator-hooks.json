{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/astragentic/coordinator-turn-end.sh\" \"$(git rev-parse --show-toplevel)\" --stop",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/astragentic/host-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
